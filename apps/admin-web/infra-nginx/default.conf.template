# Admin Web static hosting. Owner: AI #7 (infrastructure).
# Rendered by the nginx image's envsubst at container start.

# NO `add_header` INSIDE A LOCATION. nginx inherits a server block's
# add_header directives into a location only when that location has none of its
# own, so a single per-location add_header silently strips the CSP, HSTS and
# nosniff from every response it serves. That is exactly how Admin Web's own
# index.html went out without a CSP (frame-ancestors) or HSTS until PD-28.
# Anything that differs per path is therefore chosen by a map here and sent
# once, at server level; scripts/infra/check-web-headers.sh asserts the result
# in CI (on the built image) and after every deploy (smoke.sh).
#
# Cache-Control per path. An empty value sends no header.
#   /assets/   Vite's content-hashed bundles: cached for good (with `expires 1y`)
#   /index.html  never cached: it names the bundles of THIS release
#   /teacher/  the PD-28 portal: Flutter's names are not hashed, so every file
#              is revalidated (ETag, a 304 when unchanged)
map $uri $jawwid_cache_control {
    ~^/assets/        "public, immutable";
    /index.html       "no-store, must-revalidate";
    ~^/teacher(/|$)   "no-cache";
    default           "";
}

# PD-28: one policy per app on this origin. Admin Web keeps its policy byte for
# byte; the teacher portal under /teacher/ (the Flutter web build, see
# docs/mobile/teacher-web-portal.md) gets a copy with exactly three additions:
#
#   script-src 'wasm-unsafe-eval'   CanvasKit, Flutter's renderer, is WebAssembly,
#                                   and compiling ANY WebAssembly under a CSP needs
#                                   this keyword. It allows WebAssembly only -- not
#                                   eval(), not inline script; script-src stays 'self'.
#   connect-src blob: data:         the portal reads a picked photo or file through
#                                   its blob: URL (the browser's handle on it) to
#                                   upload it, and Flutter decodes images and the
#                                   bundled fonts by fetching them.
#   img-src API + store             Flutter fetches images itself (connect-src); the
#                                   same origins in img-src cover its <img> fallback.
#
# No third-party host is added: CanvasKit and the fonts are served from /teacher/
# (`--no-web-resources-cdn`), never from gstatic.
#
# PD-29 Materials. Both policies gain `frame-src ${API_ORIGIN}
# ${MATERIALS_FRAME_ORIGINS}` and nothing wider -- never a bare `https:` or `*`
# (scripts/infra/check-web-headers.sh asserts it):
#   API_ORIGIN               an uploaded package plays from the API's
#                            /materials/play/..., in <iframe sandbox="allow-scripts
#                            allow-forms"> (never allow-same-origin)
#   MATERIALS_FRAME_ORIGINS  the lessons site and any other allowlisted origin,
#                            in <iframe sandbox="allow-scripts allow-same-origin
#                            allow-forms"> (it keeps its OWN origin, never ours)
# The teacher portal needs it too: there a package or a lesson plays in an
# iframe, never in a top-level tab. Any other link opens in the browser.
# Admin Web's policy also names the store in `img-src` (an image item's signed
# URL). frame-ancestors stays 'none': nothing may frame the console.
map $uri $jawwid_csp {
    ~^/teacher(/|$)  "default-src 'self'; base-uri 'self'; frame-ancestors 'none'; object-src 'none'; frame-src ${API_ORIGIN} ${MATERIALS_FRAME_ORIGINS}; img-src 'self' data: blob: ${API_ORIGIN} ${STORAGE_ORIGIN}; media-src 'self' blob: ${API_ORIGIN} ${STORAGE_ORIGIN}; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'wasm-unsafe-eval'; connect-src 'self' blob: data: ${API_ORIGIN} ${REALTIME_ORIGIN} ${LIVEKIT_ORIGIN} ${STORAGE_ORIGIN}; form-action 'self'";
    default          "default-src 'self'; base-uri 'self'; frame-ancestors 'none'; object-src 'none'; frame-src ${API_ORIGIN} ${MATERIALS_FRAME_ORIGINS}; img-src 'self' data: blob: ${STORAGE_ORIGIN}; media-src 'self' blob: ${API_ORIGIN} ${STORAGE_ORIGIN}; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ${API_ORIGIN} ${REALTIME_ORIGIN} ${LIVEKIT_ORIGIN} ${STORAGE_ORIGIN}; form-action 'self'";
}

server {
    listen       ${NGINX_PORT};
    server_name  _;
    root         /usr/share/nginx/html;

    # Never advertise the nginx version to the internet.
    server_tokens off;

    # The Admin Web bundle is an internal staff tool. Search engines have no
    # business indexing it even if a URL escapes.
    add_header X-Robots-Tag "noindex, nofollow" always;

    add_header X-Content-Type-Options    "nosniff" always;
    add_header Referrer-Policy           "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy        "geolocation=(), camera=(), payment=(), usb=()" always;
    # HSTS is set here for the container case. Behind a CDN or load balancer
    # that already sets it, remove one of the two -- duplicated HSTS headers
    # are ignored by some browsers, which silently disables it.
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # frame-ancestors 'none' replaces X-Frame-Options: it is the version modern
    # browsers honour, and clickjacking an admin console that can transfer
    # family ownership is a real risk, not a theoretical one.
    #
    # connect-src is pinned to this environment's API and realtime origins,
    # plus the object store a voice note is uploaded to (STORAGE_ORIGIN, the
    # host of the API's signed upload URLs). media-src adds the API and the
    # store, which serve the signed URLs a voice note plays from.
    # A wildcard here would let injected script exfiltrate customer messages to
    # any host it liked. The policy itself is chosen per app by the map above.
    add_header Content-Security-Policy $jawwid_csp always;
    add_header Cache-Control $jawwid_cache_control always;

    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Vite emits content-hashed filenames under /assets, so these are safe to
    # cache permanently. A new deploy produces new names. (Cache-Control comes
    # from $jawwid_cache_control; `expires` adds the max-age.)
    location /assets/ {
        expires 1y;
        try_files $uri =404;
    }

    # index.html must NEVER be cached: it is the file that points at the hashed
    # bundles. A cached index.html is how a browser keeps loading the previous
    # release after a rollback and reports "the fix didn't deploy".
    # (Cache-Control: no-store, from $jawwid_cache_control.)
    location = /index.html {
        try_files $uri =404;
    }

    # PD-28: the teacher web portal. Unknown paths fall back to the portal's own
    # index.html; it routes with #-URLs, so the fallback only ever serves a
    # reload or a mistyped path. `=404` (not a redirect) when no portal is in
    # the image, so a local Admin Web image without one answers 404 instead of
    # looping. (Cache-Control: no-cache, from $jawwid_cache_control.)
    location = /teacher {
        absolute_redirect off;
        return 301 /teacher/;
    }

    location /teacher/ {
        try_files $uri $uri/index.html /teacher/index.html =404;
    }

    # SPA routing: unknown paths are client routes, not 404s.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
