   "blocks": [
    {
     "id": "thiqa-001",
     "kind": "text",
     "text": "كان الناس يحفظون أموالهم و أشياءهم الثمينة عند النبي محمد ﷺ",
     "review": null
    },
    {
     "id": "thiqa-002",
     "kind": "text",
     "text": "لأنهم كانوا يعرفون أنه أمين لا يخون أحداً",
