# Jawwid Chat API - example environment. Never commit a real .env
DATABASE_URL="postgresql://jawwid:jawwid@localhost:5433/jawwid_chat?schema=public"
REDIS_URL="redis://localhost:6380"
PORT=3000

# Object storage (S3-compatible). Attachments are never stored in Postgres.
STORAGE_ENDPOINT="http://localhost:9000"
STORAGE_BUCKET="jawwid-chat-attachments"
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_SIGNED_URL_TTL_SECONDS=300

# Attachment limits (bytes)
ATTACHMENT_MAX_BYTES_IMAGE=10485760
ATTACHMENT_MAX_BYTES_VIDEO=104857600
ATTACHMENT_MAX_BYTES_VOICE=16777216
ATTACHMENT_MAX_BYTES_FILE=26214400
