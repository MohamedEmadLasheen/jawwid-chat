/// A STUDENT certificate: requested by the learner's teacher, issued or declined once.
model LearnerCertificate {
  id               String    @id @default(uuid()) @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  learnerId        String    @map("learner_id") @db.Uuid
  requestedBy      String    @map("requested_by") @db.Uuid
  title            String
  achievement      String
  achievedOn       DateTime  @map("achieved_on") @db.Date
  grade            String?
  printedName      String    @map("printed_name")
  note             String?
  state            String    @default("requested")
  requestedAt      DateTime  @map("requested_at") @db.Timestamptz @default(now())
  requestMessageId String?   @unique @map("request_message_id") @db.Uuid
  decidedBy        String?   @map("decided_by") @db.Uuid
  decidedAt        DateTime? @map("decided_at") @db.Timestamptz
  declineReason    String?   @map("decline_reason")
