  at             DateTime     @default(now()) @db.Timestamptz
  reason         String?
  txid           BigInt       @default(dbgenerated("txid_current()"))

  @@map("lesson_report_revision")
  @@schema("chat")
}

/// PD-15: a corrected lesson outcome. Append-only; honoured by chat.guard_lesson
