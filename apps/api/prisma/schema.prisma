  recordedBy          String    @map("recorded_by") @db.Uuid
  recordedAt          DateTime  @map("recorded_at") @db.Timestamptz @default(now())
  confirmedAt         DateTime? @map("confirmed_at") @db.Timestamptz
  coreSubscriptionRef String?   @map("core_subscription_ref")

  @@map("trial_outcome")
  @@schema("chat")
}
