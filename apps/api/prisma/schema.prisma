/// A lesson the teacher apologised for, did not give, or started late -- and the one decision on it.
model TeacherViolation {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  teacherId      String    @map("teacher_id") @db.Uuid
  lessonId       String    @map("lesson_id") @db.Uuid
  kind           String
  occurredAt     DateTime  @map("occurred_at") @db.Timestamptz
  month          DateTime  @db.Date
  lateMinutes    Int?      @map("late_minutes")
  recordedBy     String?   @map("recorded_by") @db.Uuid
  recordedAt     DateTime  @map("recorded_at") @db.Timestamptz @default(now())
  note           String?
  decision       String?
  suggestedStep  Int?      @map("suggested_step")
  decisionNote   String?   @map("decision_note")
  decidedBy      String?   @map("decided_by") @db.Uuid
  decidedAt      DateTime? @map("decided_at") @db.Timestamptz
  suspensionId   String?   @unique @map("suspension_id") @db.Uuid

  @@unique([lessonId, kind])
  @@map("teacher_violation")
  @@schema("chat")
}

/// A temporary or permanent teacher suspension, decided on a violation.
model TeacherSuspension {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  teacherId      String    @map("teacher_id") @db.Uuid
  kind           String
  startsOn       DateTime  @map("starts_on") @db.Date
  endsOn         DateTime? @map("ends_on") @db.Date
  reason         String
  createdBy      String    @map("created_by") @db.Uuid
  createdAt      DateTime  @map("created_at") @db.Timestamptz @default(now())

  @@map("teacher_suspension")
  @@schema("chat")
}

