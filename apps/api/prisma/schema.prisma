// =====================================================================
// Identity foundation (PR-A).
//
// docs/architecture/IDENTITY-MODEL.md is canonical; the SQL migrations
// 20260910120000/120100 own the DDL. Nothing here is exposed through a DTO:
// AccountCredential and Session hold authentication material and must never
// leave the auth service, and the mappers in
// src/communication/contracts/dto.ts enumerate their fields explicitly, so a
// model added here cannot leak into a response by accident.
// =====================================================================

/// The login identity. Carries an opaque subject and never a contact channel
/// (BR-2, guarded by db/tests/invariants.sql).
model Account {
  /// PRD 2.3 -- organization_id on every root entity. SQL owns the DDL.
  organizationId String @default(dbgenerated("chat.default_organization_id()")) @map("organization_id") @db.Uuid
  id             String    @id @default(uuid()) @db.Uuid
  subject        String    @unique
  /// staff | family | teacher
  kind           String
  /// provisioned | active | suspended | deactivated
  status         String    @default("active")
  isActive       Boolean   @map("is_active") @default(true)
  deactivatedAt  DateTime? @map("deactivated_at") @db.Timestamptz
  deactivatedBy  String?   @map("deactivated_by") @db.Uuid
  lastLoginAt    DateTime? @map("last_login_at") @db.Timestamptz
  createdAt      DateTime  @map("created_at") @db.Timestamptz @default(now())
  updatedAt      DateTime  @map("updated_at") @db.Timestamptz @default(now()) @updatedAt

  credential AccountCredential?
  sessions   Session[]
  devices    Device[]
  teacher    Teacher?
  contacts   Contact[]
  staff      Staff?

  @@map("account")
  @@schema("chat")
}

/// Password material. One row per account; absence means the account cannot
/// log in with a password. Never selected outside the login path.
model AccountCredential {
  accountId         String    @id @map("account_id") @db.Uuid
  account           Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  passwordHash      String    @map("password_hash")
  passwordChangedAt DateTime  @map("password_changed_at") @db.Timestamptz @default(now())
  failedAttempts    Int       @map("failed_attempts") @default(0)
  lockedUntil       DateTime? @map("locked_until") @db.Timestamptz
  updatedAt         DateTime  @map("updated_at") @db.Timestamptz @default(now()) @updatedAt

  @@map("account_credential")
  @@schema("chat")
}

/// One row per login. The access token carries this row's id as `sid`, so
/// revoking the row ends the session on the next request.
model Session {
  organizationId   String @default(dbgenerated("chat.default_organization_id()")) @map("organization_id") @db.Uuid
  id               String    @id @default(uuid()) @db.Uuid
  accountId        String    @map("account_id") @db.Uuid
  account          Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  deviceId         String?   @map("device_id") @db.Uuid
  device           Device?   @relation(fields: [deviceId], references: [id])
  /// Hashed. The refresh token itself is never stored.
  refreshTokenHash String    @unique @map("refresh_token_hash")
  createdAt        DateTime  @map("created_at") @db.Timestamptz @default(now())
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz
  lastSeenAt       DateTime? @map("last_seen_at") @db.Timestamptz
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz
  revokedBy        String?   @map("revoked_by") @db.Uuid
  revokedReason    String?   @map("revoked_reason")
  /// Hashed, never the raw address.
  ipHash           String?   @map("ip_hash")
  userAgent        String?   @map("user_agent")

  @@map("session")
  @@schema("chat")
}

/// A device an account signs in on. `name` is a label such as "iPhone" and is
/// never a phone number.
model Device {
  organizationId String @default(dbgenerated("chat.default_organization_id()")) @map("organization_id") @db.Uuid
  id           String   @id @default(uuid()) @db.Uuid
  accountId    String   @map("account_id") @db.Uuid
  account      Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  /// ios | android | web
  platform     String
  appVersion   String?  @map("app_version")
  name         String?
  firstSeenAt  DateTime @map("first_seen_at") @db.Timestamptz @default(now())
  lastSeenAt   DateTime @map("last_seen_at") @db.Timestamptz @default(now())
  createdAt    DateTime @map("created_at") @db.Timestamptz @default(now())
  updatedAt    DateTime @map("updated_at") @db.Timestamptz @default(now()) @updatedAt

  sessions Session[]

  @@map("device")
  @@schema("chat")
}

/// Teacher identity. Not a staff role: `staff.role` deliberately has no
/// teacher, because the family-facing role set would then decide whether a
/// teacher may communicate (domain-reconciliation.md C).
model Teacher {
  organizationId String @default(dbgenerated("chat.default_organization_id()")) @map("organization_id") @db.Uuid
  id            String    @id @default(uuid()) @db.Uuid
  /// Null until a login is provisioned; such a teacher can never authenticate.
  accountId     String?   @unique @map("account_id") @db.Uuid
  account       Account?  @relation(fields: [accountId], references: [id])
  name          String
  /// Set when Jawwid Core gains a teacher entity.
  coreTeacherId String?   @unique @map("core_teacher_id")
  syncedAt      DateTime? @map("synced_at") @db.Timestamptz
  /// A profile photo: `avatars/<kind>/<this id>/<uuid>` (CHECK in 20261014130000). Never sent to a client; served as a signed /media/avatars URL.
  avatarObjectKey String?  @map("avatar_object_key")
  isActive      Boolean   @map("is_active") @default(true)
  leftAt        DateTime? @map("left_at") @db.Timestamptz
  createdAt     DateTime  @map("created_at") @db.Timestamptz @default(now())
  updatedAt     DateTime  @map("updated_at") @db.Timestamptz @default(now()) @updatedAt

  learners Learner[]
  lessons  Lesson[]

  @@map("teacher")
  @@schema("chat")
}

// =====================================================================
// Stories -- 20260928120000_chat_stories.sql owns the DDL.
// =====================================================================

/// A short-lived publication to a server-resolved audience.
model Story {
  /// PRD 2.3 -- organization_id on every root entity. SQL owns the DDL.
  organizationId String @default(dbgenerated("chat.default_organization_id()")) @map("organization_id") @db.Uuid
  id             String  @id @default(uuid()) @db.Uuid
  /// Legacy. Nothing writes it since 2026-10-17: a story carries no caption.
  title          String?
  /// The words of a TEXT story. A photo, video or voice story has none.
  body           String?
  /// The publisher's own label. Publisher surfaces only; never sent to a reader.
  internalName   String? @map("internal_name")
  /// Background of a text or voice story, from a fixed palette.
  background     String?

  /// A key into private object storage. Never a URL, and never a capability:
  /// reads go through a short-lived signed URL minted per request.
  mediaObjectKey String? @map("media_object_key")
  mediaKind      String? @map("media_kind")
  mediaMime      String? @map("media_mime")
  /// image | video | audio. Client-asserted for audio/video; bounded by a check.
  mediaDurationMs Int?   @map("media_duration_ms")

  /// The call to action: whatsapp | message_publisher | link, or none.
  ctaKind  String? @map("cta_kind")
  ctaLabel String? @map("cta_label")
  /// https only (story_cta_shape).
  ctaUrl   String? @map("cta_url")
  /// The ACADEMY's WhatsApp number, E.164 digits. Never a family's.
  ctaPhone String? @map("cta_phone")

  /// draft | published | expired | deleted. Transitions are guarded by
  /// chat.guard_story_transition(); `deleted` is terminal.
  state       String    @default("draft")
  publishedAt DateTime? @map("published_at") @db.Timestamptz
  /// When access ends; NULL means "until deleted" (every story since
  /// 2026-10-17). A non-null value is still part of the read invariant.
  expiresAt   DateTime? @map("expires_at") @db.Timestamptz

  createdBy   String @map("created_by") @db.Uuid
  creator     Staff  @relation("StoryCreatedBy", fields: [createdBy], references: [id])
  publishedBy String? @map("published_by") @db.Uuid
  publisher   Staff?  @relation("StoryPublishedBy", fields: [publishedBy], references: [id])

  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz
  deletedBy     String?   @map("deleted_by") @db.Uuid
  deleter       Staff?    @relation("StoryDeletedBy", fields: [deletedBy], references: [id])
  deletedReason String?   @map("deleted_reason")

  /// Stamped once the bytes are actually gone from object storage.
  mediaPurgedAt DateTime? @map("media_purged_at") @db.Timestamptz

  createdAt DateTime @map("created_at") @db.Timestamptz @default(now())
  updatedAt DateTime @map("updated_at") @db.Timestamptz @default(now()) @updatedAt

  audiences  StoryAudience[]
  recipients StoryRecipient[]
  views      StoryView[]
  ctaClicks  StoryCtaClick[]

  @@map("story")
  @@schema("chat")
}

/// The audience as AUTHORED. An operator surface: it names families, groups and
/// teachers, so a reader never sees it.
model StoryAudience {
  id        String   @id @default(uuid()) @db.Uuid
  storyId   String   @map("story_id") @db.Uuid
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  /// all_families | all_teachers | assigned_families | family | teacher | contact | conversation | segment
  kind      String
  /// kind = segment only: { who, planMonths?, children?, countries? }.
  filter    Json?
  /// Null exactly for the kinds that name no particular record. Not a foreign
  /// key: it points into a different table per kind, and the resolver validates
  /// it under the author's own scope.
  refId     String?  @map("ref_id") @db.Uuid
  createdAt DateTime @map("created_at") @db.Timestamptz @default(now())

  @@map("story_audience")
  @@schema("chat")
}

/// The audience RESOLVED to people, once, server-side. The composite primary key
/// is the deduplication guarantee for overlapping clauses.
model StoryRecipient {
  storyId     String   @map("story_id") @db.Uuid
  story       Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  actorId     String   @map("actor_id") @db.Uuid
  actorKind   String   @map("actor_kind")
  /// Which clause first matched this person. Reporting only, never authorization.
  matchedKind String   @map("matched_kind")
  createdAt   DateTime @map("created_at") @db.Timestamptz @default(now())

  @@id([storyId, actorId])
  @@map("story_recipient")
  @@schema("chat")
}

model StoryView {
  storyId  String   @map("story_id") @db.Uuid
  story    Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  actorId  String   @map("actor_id") @db.Uuid
  viewedAt DateTime @map("viewed_at") @db.Timestamptz @default(now())

  @@id([storyId, actorId])
  @@map("story_view")
  @@schema("chat")
}

/// One row per call-to-action tap. Tapping twice is two taps.
model StoryCtaClick {
  id        BigInt   @id @default(autoincrement())
  storyId   String   @map("story_id") @db.Uuid
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  actorId   String   @map("actor_id") @db.Uuid
  clickedAt DateTime @map("clicked_at") @db.Timestamptz @default(now())

  @@index([storyId, clickedAt])
  @@map("story_cta_click")
  @@schema("chat")
}

