  @@schema("chat")
}

/// Who a staff member reports to. Decides PROFILE visibility only.
model StaffReportingLine {
  staffId        String   @id @map("staff_id") @db.Uuid
  staff          Staff    @relation("ReportingLineMember", fields: [staffId], references: [id], onDelete: Cascade)
  organizationId String   @default(dbgenerated("chat.default_organization_id()")) @map("organization_id") @db.Uuid
  managerId      String   @map("manager_id") @db.Uuid
