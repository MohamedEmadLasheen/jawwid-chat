  @@schema("chat")
}

// =====================================================================
// PD-8 organization structure -- 20261015120000_chat_pd008_org_structure.sql
// owns the DDL. Staff references are plain columns (no Prisma relation) so the
// Staff model, which other lineages also extend, is not touched.
// Every row here IS an authorization input: chat.staff_conversation_access
// reads them. Writes go through OrgStructureService only.
// =====================================================================

model Department {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @default(dbgenerated("chat.default_organization_id()")) @map("organization_id") @db.Uuid
  kind           String
  displayName    String   @map("display_name")
  managerId      String?  @map("manager_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  members DepartmentMember[]

  @@unique([organizationId, kind])
  @@map("department")
  @@schema("chat")
}

model DepartmentMember {
  staffId        String     @id @map("staff_id") @db.Uuid
  organizationId String     @map("organization_id") @db.Uuid
  departmentId   String     @map("department_id") @db.Uuid
  department     Department @relation(fields: [departmentId], references: [id])
  position       String
  assignedBy     String?    @map("assigned_by") @db.Uuid
  assignedAt     DateTime   @default(now()) @map("assigned_at") @db.Timestamptz

  @@map("department_member")
  @@schema("chat")
}

