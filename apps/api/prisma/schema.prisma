// Jawwid Chat -- Prisma mapping layer.
//
// THE SQL MIGRATIONS IN supabase/migrations ARE AUTHORITATIVE FOR DDL.
// This file is a typed access layer mapped onto that schema; it never defines
// the schema. `npm run db:drift` proves the two agree.
//
// Enumerations are text + check constraint in SQL (AI #1's convention), so they
// surface here as String. The allowed values live in src/communication/contracts/vocab.ts.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["chat"]
}

// =====================================================================
// AI #1's tables -- read-mostly from the communication engine.
// =====================================================================

model Staff {
  /// PRD 2.3 -- organization_id on every root entity. SQL owns the DDL.
  organizationId String @default(dbgenerated("chat.default_organization_id()")) @map("organization_id") @db.Uuid
  id             String    @id @default(uuid()) @db.Uuid
  /// The login this staff member authenticates with. Null = provisioned but not yet able to log in.
  accountId      String?   @unique @map("account_id") @db.Uuid
  account        Account?  @relation(fields: [accountId], references: [id])
  name           String
  role           String
  /// A routing attribute, never a role (AUTHORIZATION-MODEL.md 2). Set = not family-facing.
  department     String?
  presence       String    @default("offline")
  lastActivityAt DateTime? @map("last_activity_at") @db.Timestamptz
  isActive       Boolean   @map("is_active") @default(true)
  leftAt         DateTime? @map("left_at") @db.Timestamptz
  createdAt      DateTime  @map("created_at") @db.Timestamptz @default(now())
  updatedAt      DateTime  @map("updated_at") @db.Timestamptz @default(now()) @updatedAt

  ownedFamilies  Family[]        @relation("FamilyOwner")
  stickyOf       Conversation[]  @relation("ConversationStickyHandler")
  assignments    FamilyAssignment[] @relation("AssignmentStaff")

  @@map("staff")
  @@schema("chat")
}

model Family {
  /// PRD 2.3 -- organization_id on every root entity. SQL owns the DDL.
  organizationId String @default(dbgenerated("chat.default_organization_id()")) @map("organization_id") @db.Uuid
  id               String   @id @default(uuid()) @db.Uuid
  displayName      String   @map("display_name")
  ownerId          String   @map("owner_id") @db.Uuid
  owner            Staff    @relation("FamilyOwner", fields: [ownerId], references: [id])
  primaryContactId String?  @map("primary_contact_id") @db.Uuid
  tier             String   @default("standard")
  state            String   @default("onboarding")
  language         String   @default("ar")
  createdAt        DateTime @map("created_at") @db.Timestamptz @default(now())
  updatedAt        DateTime @map("updated_at") @db.Timestamptz @default(now()) @updatedAt

  contacts      Contact[]
  learners      Learner[]
  conversations Conversation[]
  assignments   FamilyAssignment[]

  @@map("family")
  @@schema("chat")
}

model Contact {
  /// PRD 2.3 -- organization_id on every root entity. SQL owns the DDL.
  organizationId String @default(dbgenerated("chat.default_organization_id()")) @map("organization_id") @db.Uuid
  id                String   @id @default(uuid()) @db.Uuid
  familyId          String   @map("family_id") @db.Uuid
  family            Family   @relation(fields: [familyId], references: [id])
  accountId         String?  @map("account_id") @db.Uuid
  account           Account? @relation(fields: [accountId], references: [id])
  name              String
  relationship      String?
  rolePreset        String   @map("role_preset")
  canMessage        Boolean  @map("can_message") @default(false)
  canViewProgress   Boolean  @map("can_view_progress")
  canManageSchedule Boolean  @map("can_manage_schedule")
  canManageBilling  Boolean  @map("can_manage_billing")
  canManageContacts Boolean  @map("can_manage_contacts")
  canCancel         Boolean  @map("can_cancel")
  isActive          Boolean  @map("is_active") @default(true)
  createdAt         DateTime @map("created_at") @db.Timestamptz @default(now())
  updatedAt         DateTime @map("updated_at") @db.Timestamptz @default(now()) @updatedAt

  @@map("contact")
  @@schema("chat")
}

model Learner {
  /// PRD 2.3 -- organization_id on every root entity. SQL owns the DDL.
  organizationId String @default(dbgenerated("chat.default_organization_id()")) @map("organization_id") @db.Uuid
  id          String    @id @default(uuid()) @db.Uuid
  familyId    String    @map("family_id") @db.Uuid
  family      Family    @relation(fields: [familyId], references: [id])
  name        String
  level       String?
  /// The teacher who teaches this learner. An application relationship and a
  /// foreign key since Phase 1 -- NOT an identity source.
  teacherId   String?   @map("teacher_id") @db.Uuid
  teacher     Teacher?  @relation(fields: [teacherId], references: [id])
  nextClassAt DateTime? @map("next_class_at") @db.Timestamptz
  createdAt   DateTime  @map("created_at") @db.Timestamptz @default(now())
  updatedAt   DateTime  @map("updated_at") @db.Timestamptz @default(now()) @updatedAt

  conversations Conversation[]

  @@map("learner")
  @@schema("chat")
}

model Config {
  key       String   @id
  value     Json
  scope     String   @default("global")
  updatedAt DateTime @map("updated_at") @db.Timestamptz @default(now()) @updatedAt

  @@map("config")
  @@schema("chat")
}

model EventLog {
  /// bigint identity, generated by the database (AI #1's definition).
  id        BigInt   @id @default(autoincrement())
  organizationId String @default(dbgenerated("chat.default_organization_id()")) @map("organization_id") @db.Uuid
  familyId  String?  @map("family_id") @db.Uuid
  actorKind String   @map("actor_type")
  actorId   String?  @map("actor_id") @db.Uuid
  type      String
  payload   Json     @default("{}")
  at        DateTime @db.Timestamptz @default(now())

  @@map("event_log")
  @@schema("chat")
}

model AuditLog {
  /// bigint identity, generated by the database (AI #1's definition).
  id       BigInt   @id @default(autoincrement())
  organizationId String @default(dbgenerated("chat.default_organization_id()")) @map("organization_id") @db.Uuid
  actorId  String?  @map("actor_id") @db.Uuid
  action   String
  entity   String
  entityId String   @map("entity_id") @db.Uuid
  before   Json?
  after    Json?
  reason   String
  at       DateTime @db.Timestamptz @default(now())

  @@map("audit_log")
  @@schema("chat")
}

// =====================================================================
// AI #2 -- communication domain
// =====================================================================

model Conversation {
  /// PRD 2.3 -- organization_id on every root entity. SQL owns the DDL.
  organizationId String @default(dbgenerated("chat.default_organization_id()")) @map("organization_id") @db.Uuid
  id        String  @id @default(uuid()) @db.Uuid
  type      String
  familyId  String? @map("family_id") @db.Uuid
  family    Family? @relation(fields: [familyId], references: [id])
  learnerId String? @map("learner_id") @db.Uuid
  learner   Learner? @relation(fields: [learnerId], references: [id])
  title     String?

  /// Canonical id of a 1:1 channel; makes a duplicate direct conversation impossible.
  directKey String? @unique @map("direct_key")

  state String @default("open")

  teacherRequiresApproval Boolean @map("teacher_requires_approval") @default(true)
  parentRequiresApproval  Boolean @map("parent_requires_approval") @default(true)

  stickyHandlerId String?   @map("sticky_handler_id") @db.Uuid
  stickyHandler   Staff?    @relation("ConversationStickyHandler", fields: [stickyHandlerId], references: [id])
  stickyUntil     DateTime? @map("sticky_until") @db.Timestamptz

  /// Server-assigned monotonic message counter.
  lastSeq BigInt @map("last_seq") @default(0)

  lastCustomerMessageAt DateTime? @map("last_customer_message_at") @db.Timestamptz
  lastStaffMessageAt    DateTime? @map("last_staff_message_at") @db.Timestamptz
  lastActivityAt        DateTime  @map("last_activity_at") @db.Timestamptz @default(now())
  resolvedAt            DateTime? @map("resolved_at") @db.Timestamptz
  archivedAt            DateTime? @map("archived_at") @db.Timestamptz
  createdAt             DateTime  @map("created_at") @db.Timestamptz @default(now())
  updatedAt             DateTime  @map("updated_at") @db.Timestamptz @default(now()) @updatedAt

  members      ConversationMember[]
  messages     Message[]
  approvals    MessageApproval[]
  participants ConversationParticipantState[]
  calls        Call[]
  notifications Notification[]

  @@map("conversation")
  @@schema("chat")
}

/// The explicit participant set BR-1 is enforced against.
model ConversationMember {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @map("conversation_id") @db.Uuid
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  actorKind      String       @map("actor_kind")
  actorId        String       @map("actor_id") @db.Uuid
  memberRole     String       @map("member_role")
  isSilent       Boolean      @map("is_silent") @default(false)
  addedBy        String?      @map("added_by") @db.Uuid
  joinedAt       DateTime     @map("joined_at") @db.Timestamptz @default(now())
  leftAt         DateTime?    @map("left_at") @db.Timestamptz

  @@map("conversation_member")
  @@schema("chat")
}

model Message {
  /// PRD 2.3 -- organization_id on every root entity. SQL owns the DDL.
  organizationId String @default(dbgenerated("chat.default_organization_id()")) @map("organization_id") @db.Uuid
  id             String        @id @default(uuid()) @db.Uuid
  conversationId String?       @map("conversation_id") @db.Uuid
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  authorType   String  @map("author_type")
  authorId     String? @map("author_id") @db.Uuid
  onBehalfMode String? @map("on_behalf_mode")

  type       String @default("text")
  body       String?
  visibility String
  moderation String @default("published")
  origin     String @default("user")

  seq BigInt?

  replyToMessageId String?   @map("reply_to_message_id") @db.Uuid
  replyTo          Message?  @relation("MessageReply", fields: [replyToMessageId], references: [id])
  replies          Message[] @relation("MessageReply")

  clientMessageId String? @map("client_message_id")

  /// Phase 2. Null = never edited. A body change without one is refused by
  /// chat.forbid_message_rewrite(), so an edit is always stamped.
  editedAt  DateTime? @map("edited_at") @db.Timestamptz
  editedBy  String?   @map("edited_by") @db.Uuid
  editCount Int       @map("edit_count") @default(0)

  /// Phase 2 forwarding provenance. Audit only -- never served to a client,
  /// because the source conversation is often outside the recipient's scope.
  forwardedFromMessageId      String?  @map("forwarded_from_message_id") @db.Uuid
  forwardedFrom               Message? @relation("MessageForward", fields: [forwardedFromMessageId], references: [id])
  forwards                    Message[] @relation("MessageForward")
  forwardedFromConversationId String?  @map("forwarded_from_conversation_id") @db.Uuid

  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz
  deletedBy      String?   @map("deleted_by") @db.Uuid
  deletedForAll  Boolean   @map("deleted_for_all") @default(false)
  redactedReason String?   @map("redacted_reason")

  /// Superseded by MessageAttachment; kept because AI #1 defined it NOT NULL.
  attachmentsJson Json @map("attachments") @default("[]")

  createdAt DateTime @map("created_at") @db.Timestamptz @default(now())

  attachments MessageAttachment[]
  reactions   MessageReaction[]
  receipts    MessageReceipt[]
  hiddenFor   MessageHiddenFor[]
  revisions   MessageRevision[]
  approval    MessageApproval?

  @@map("message")
  @@schema("chat")
}

model MessageAttachment {
  id                 String   @id @default(uuid()) @db.Uuid
  messageId          String   @map("message_id") @db.Uuid
  message            Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  kind               String
  objectKey          String   @unique @map("object_key")
  mimeType           String   @map("mime_type")
  byteSize           Int      @map("byte_size")
  checksumSha256     String?  @map("checksum_sha256")
  originalName       String?  @map("original_name")
  durationMs         Int?     @map("duration_ms")
  width              Int?
  height             Int?
  thumbnailObjectKey String?  @map("thumbnail_object_key")
  createdAt          DateTime @map("created_at") @db.Timestamptz @default(now())

  @@map("message_attachment")
  @@schema("chat")
}

model MessageReaction {
  id        String   @id @default(uuid()) @db.Uuid
  messageId String   @map("message_id") @db.Uuid
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  actorId   String   @map("actor_id") @db.Uuid
  emoji     String
  createdAt DateTime @map("created_at") @db.Timestamptz @default(now())

  @@unique([messageId, actorId])
  @@map("message_reaction")
  @@schema("chat")
}

model MessageReceipt {
  id          String    @id @default(uuid()) @db.Uuid
  messageId   String    @map("message_id") @db.Uuid
  message     Message   @relation(fields: [messageId], references: [id], onDelete: Cascade)
  actorId     String    @map("actor_id") @db.Uuid
  state       String    @default("sent")
  sentAt      DateTime  @map("sent_at") @db.Timestamptz @default(now())
  deliveredAt DateTime? @map("delivered_at") @db.Timestamptz
  readAt      DateTime? @map("read_at") @db.Timestamptz

  @@unique([messageId, actorId])
  @@map("message_receipt")
  @@schema("chat")
}

model MessageHiddenFor {
  messageId String   @map("message_id") @db.Uuid
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  actorId   String   @map("actor_id") @db.Uuid
  hiddenAt  DateTime @map("hidden_at") @db.Timestamptz @default(now())

  @@id([messageId, actorId])
  @@map("message_hidden_for")
  @@schema("chat")
}

/// Append-only history of superseded message bodies (Phase 2).
///
/// Revision 1 is what the message was SENT with; each edit appends the body it
/// replaced. A database trigger refuses UPDATE and DELETE, so an edit can never
/// destroy what was actually said.
model MessageRevision {
  id         String   @id @default(uuid()) @db.Uuid
  messageId  String   @map("message_id") @db.Uuid
  message    Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  revision   Int
  body       String?
  replacedBy String   @map("replaced_by") @db.Uuid
  replacedAt DateTime @map("replaced_at") @db.Timestamptz @default(now())

  @@unique([messageId, revision])
  @@map("message_revision")
  @@schema("chat")
}

model ConversationParticipantState {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @map("conversation_id") @db.Uuid
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  actorId        String       @map("actor_id") @db.Uuid
  lastReadSeq    BigInt       @map("last_read_seq") @default(0)
  archivedAt     DateTime?    @map("archived_at") @db.Timestamptz
  mutedUntil     DateTime?    @map("muted_until") @db.Timestamptz
  pinnedAt       DateTime?    @map("pinned_at") @db.Timestamptz
  updatedAt      DateTime     @map("updated_at") @db.Timestamptz @default(now()) @updatedAt

  @@unique([conversationId, actorId])
  @@map("conversation_participant_state")
  @@schema("chat")
}

model MessageApproval {
  /// PRD 2.3 -- organization_id on every root entity. SQL owns the DDL.
  organizationId String @default(dbgenerated("chat.default_organization_id()")) @map("organization_id") @db.Uuid
  id              String       @id @default(uuid()) @db.Uuid
  messageId       String       @unique @map("message_id") @db.Uuid
  message         Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  conversationId  String       @map("conversation_id") @db.Uuid
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  requestedBy     String       @map("requested_by") @db.Uuid
  approverId      String?      @map("approver_id") @db.Uuid
  decision        String       @default("pending")
  rejectionReason String?      @map("rejection_reason")
  createdAt       DateTime     @map("created_at") @db.Timestamptz @default(now())
  decidedAt       DateTime?    @map("decided_at") @db.Timestamptz

  @@map("message_approval")
  @@schema("chat")
}

model OutboxEvent {
  id          String    @id @default(uuid()) @db.Uuid
  type        String
  payload     Json
  status      String    @default("pending")
  attempts    Int       @default(0)
  lastError   String?   @map("last_error")
  availableAt DateTime  @map("available_at") @db.Timestamptz @default(now())
  createdAt   DateTime  @map("created_at") @db.Timestamptz @default(now())
  publishedAt DateTime? @map("published_at") @db.Timestamptz

  @@map("outbox_event")
  @@schema("chat")
}

model DeviceToken {
  /// PRD 2.3 -- organization_id on every root entity. SQL owns the DDL.
  organizationId String @default(dbgenerated("chat.default_organization_id()")) @map("organization_id") @db.Uuid
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String   @map("actor_id") @db.Uuid
  deviceId   String?  @map("device_id") @db.Uuid
  device     Device?  @relation(fields: [deviceId], references: [id])
  token      String   @unique
  platform   String
  isVoip     Boolean  @map("is_voip") @default(false)
  locale     String   @default("ar")
  isActive   Boolean  @map("is_active") @default(true)
  lastSeenAt DateTime @map("last_seen_at") @db.Timestamptz @default(now())
  createdAt  DateTime @map("created_at") @db.Timestamptz @default(now())

  @@map("device_token")
  @@schema("chat")
}

model NotificationTemplate {
  /// PRD 2.3 -- organization_id on every root entity. SQL owns the DDL.
  organizationId String @default(dbgenerated("chat.default_organization_id()")) @map("organization_id") @db.Uuid
  id        String   @id @default(uuid()) @db.Uuid
  key       String
  locale    String
  version   Int      @default(1)
  title     String
  body      String
  isActive  Boolean  @map("is_active") @default(true)
  createdAt DateTime @map("created_at") @db.Timestamptz @default(now())

  @@unique([key, locale, version])
  @@map("notification_template")
  @@schema("chat")
}

model NotificationRule {
  /// PRD 2.3 -- organization_id on every root entity. SQL owns the DDL.
  organizationId String @default(dbgenerated("chat.default_organization_id()")) @map("organization_id") @db.Uuid
  key               String   @id
  eventType         String   @map("event_type")
  offsetSeconds     Int      @map("offset_seconds") @default(0)
  templateKey       String   @map("template_key")
  recipientRole     String   @map("recipient_role")
  channel           String   @default("push")
  priority          String   @default("normal")
  respectQuietHours Boolean  @map("respect_quiet_hours") @default(true)
  enabled           Boolean  @default(true)
  updatedAt         DateTime @map("updated_at") @db.Timestamptz @default(now()) @updatedAt

  notifications Notification[]

  @@map("notification_rule")
  @@schema("chat")
}

model Notification {
  /// PRD 2.3 -- organization_id on every root entity. SQL owns the DDL.
  organizationId String @default(dbgenerated("chat.default_organization_id()")) @map("organization_id") @db.Uuid
  id          String  @id @default(uuid()) @db.Uuid
  /// THE deduplication guarantee.
  dedupeKey   String  @unique @map("dedupe_key")
  ruleKey     String? @map("rule_key")
  rule        NotificationRule? @relation(fields: [ruleKey], references: [key])
  templateKey String  @map("template_key")
  eventType   String  @map("event_type")
  recipientId String  @map("recipient_id") @db.Uuid
  locale      String  @default("ar")
  channel     String  @default("push")
  priority    String  @default("normal")

  familyId       String?       @map("family_id") @db.Uuid
  conversationId String?       @map("conversation_id") @db.Uuid
  conversation   Conversation? @relation(fields: [conversationId], references: [id])
  variables      Json    @default("{}")

  status      String    @default("scheduled")
  scheduledAt DateTime  @map("scheduled_at") @db.Timestamptz
  sentAt      DateTime? @map("sent_at") @db.Timestamptz
  deliveredAt DateTime? @map("delivered_at") @db.Timestamptz
  openedAt    DateTime? @map("opened_at") @db.Timestamptz
  failedAt    DateTime? @map("failed_at") @db.Timestamptz
  failureCode String?   @map("failure_code")
  attempts    Int       @default(0)
  createdAt   DateTime  @map("created_at") @db.Timestamptz @default(now())

  @@map("notification")
  @@schema("chat")
}

model QuietHours {
  /// PRD 2.3 -- organization_id on every root entity. SQL owns the DDL.
  organizationId String @default(dbgenerated("chat.default_organization_id()")) @map("organization_id") @db.Uuid
  actorId     String  @id @map("actor_id") @db.Uuid
  timezone    String  @default("Africa/Cairo")
  startMinute Int     @map("start_minute") @default(1320)
  endMinute   Int     @map("end_minute") @default(480)
  enabled     Boolean @default(true)

  @@map("quiet_hours")
  @@schema("chat")
}

model Call {
  /// PRD 2.3 -- organization_id on every root entity. SQL owns the DDL.
  organizationId String @default(dbgenerated("chat.default_organization_id()")) @map("organization_id") @db.Uuid
  id              String       @id @default(uuid()) @db.Uuid
  conversationId  String       @map("conversation_id") @db.Uuid
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  familyId        String?      @map("family_id") @db.Uuid
  initiatorId     String       @map("initiator_id") @db.Uuid
  type            String
  /// Server-minted. A client-supplied room name is never trusted.
  roomName        String       @unique @map("room_name")
  status          String       @default("ringing")
  outcome         String?
  startedAt       DateTime     @map("started_at") @db.Timestamptz @default(now())
  answeredAt      DateTime?    @map("answered_at") @db.Timestamptz
  endedAt         DateTime?    @map("ended_at") @db.Timestamptz
  durationSeconds Int?         @map("duration_seconds")
  createdAt       DateTime     @map("created_at") @db.Timestamptz @default(now())

  participants CallParticipant[]

  @@map("call")
  @@schema("chat")
}

model CallParticipant {
  id        String    @id @default(uuid()) @db.Uuid
  callId    String    @map("call_id") @db.Uuid
  call      Call      @relation(fields: [callId], references: [id], onDelete: Cascade)
  actorId   String    @map("actor_id") @db.Uuid
  actorKind String    @map("actor_kind")
  invitedAt DateTime  @map("invited_at") @db.Timestamptz @default(now())
  joinedAt  DateTime? @map("joined_at") @db.Timestamptz
  leftAt    DateTime? @map("left_at") @db.Timestamptz

  @@unique([callId, actorId])
  @@map("call_participant")
  @@schema("chat")
}

/// Tenant root (PRD 2.3). DDL lives in supabase/migrations/20260906120000_chat_organization.sql.
model Organization {
  id           String   @id @default(uuid()) @db.Uuid
  slug         String   @unique
  displayName  String   @map("display_name")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("organization")
  @@schema("chat")
}

// =====================================================================
// Phase 1 -- identity, authentication, RBAC and supervisor scope.
// DDL lives in supabase/migrations/20260907100*.sql; this is the mapping.
// =====================================================================

/// The login identity. Carries NO contact channel by design (BR-2): `subject`
/// is an opaque identifier, never a phone number or an e-mail address.
model Account {
  id                String    @id @default(uuid()) @db.Uuid
  organizationId    String    @default(dbgenerated("chat.default_organization_id()")) @map("organization_id") @db.Uuid
  subject           String
  kind              String
  /// provisioned | active | suspended | deactivated. Authoritative.
  status            String    @default("provisioned")
  /// Derived from status by trigger. Never write it directly.
  isActive          Boolean   @map("is_active") @default(true)
  emailVerifiedAt   DateTime? @map("email_verified_at") @db.Timestamptz
  lastLoginAt       DateTime? @map("last_login_at") @db.Timestamptz
  deactivatedAt     DateTime? @map("deactivated_at") @db.Timestamptz
  deactivatedBy     String?   @map("deactivated_by") @db.Uuid
  deactivatedReason String?   @map("deactivated_reason")
  createdAt         DateTime  @map("created_at") @db.Timestamptz @default(now())
  updatedAt         DateTime  @map("updated_at") @db.Timestamptz @default(now()) @updatedAt

  credential AccountCredential?
  sessions   Session[]
  devices    Device[]
  tokens     AccountToken[]
  overrides  AccountPermissionOverride[]
  staff      Staff?
  teacher    Teacher?
  contacts   Contact[]

  @@unique([organizationId, subject], map: "account_subject_per_organization_key")
  @@map("account")
  @@schema("chat")
}

/// Password material. One row per account; absence means "cannot log in".
model AccountCredential {
  accountId          String   @id @map("account_id") @db.Uuid
  account            Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  passwordHash       String   @map("password_hash")
  passwordChangedAt  DateTime @map("password_changed_at") @db.Timestamptz @default(now())
  mustChangePassword Boolean  @map("must_change_password") @default(false)
  failedAttempts     Int      @map("failed_attempts") @default(0)
  lockedUntil        DateTime? @map("locked_until") @db.Timestamptz
  updatedAt          DateTime @map("updated_at") @db.Timestamptz @default(now()) @updatedAt

  @@map("account_credential")
  @@schema("chat")
}

/// One registered installation per account. A session binds to one.
model Device {
  id          String   @id @default(uuid()) @db.Uuid
  accountId   String   @map("account_id") @db.Uuid
  account     Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  clientKey   String   @map("client_key")
  platform    String
  appVersion  String?  @map("app_version")
  displayName String?  @map("display_name")
  firstSeenAt DateTime @map("first_seen_at") @db.Timestamptz @default(now())
  lastSeenAt  DateTime @map("last_seen_at") @db.Timestamptz @default(now())

  sessions     Session[]
  deviceTokens DeviceToken[]

  @@unique([accountId, clientKey], map: "device_account_client_key")
  @@map("device")
  @@schema("chat")
}

/// One login. The access token carries this id as `sid`, so revoking the row
/// ends the session on the next request rather than at token expiry.
model Session {
  id               String    @id @default(uuid()) @db.Uuid
  accountId        String    @map("account_id") @db.Uuid
  account          Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  deviceId         String?   @map("device_id") @db.Uuid
  device           Device?   @relation(fields: [deviceId], references: [id])
  refreshTokenHash String    @unique @map("refresh_token_hash")
  issuedAt         DateTime  @map("issued_at") @db.Timestamptz @default(now())
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz
  lastSeenAt       DateTime? @map("last_seen_at") @db.Timestamptz
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz
  revokedReason    String?   @map("revoked_reason")
  revokedBy        String?   @map("revoked_by") @db.Uuid
  userAgent        String?   @map("user_agent")
  ipHash           String?   @map("ip_hash")

  @@map("session")
  @@schema("chat")
}

/// Single-use, hashed, expiring token for e-mail verification or password reset.
model AccountToken {
  id         String    @id @default(uuid()) @db.Uuid
  accountId  String    @map("account_id") @db.Uuid
  account    Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  purpose    String
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz
  createdBy  String?   @map("created_by") @db.Uuid
  createdAt  DateTime  @map("created_at") @db.Timestamptz @default(now())

  @@map("account_token")
  @@schema("chat")
}

/// Teacher identity. Teaching a learner is a relationship; this is the identity.
model Teacher {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @default(dbgenerated("chat.default_organization_id()")) @map("organization_id") @db.Uuid
  accountId      String?   @unique @map("account_id") @db.Uuid
  account        Account?  @relation(fields: [accountId], references: [id])
  name           String
  coreTeacherId  String?   @map("core_teacher_id")
  syncedAt       DateTime? @map("synced_at") @db.Timestamptz
  isActive       Boolean   @map("is_active") @default(true)
  leftAt         DateTime? @map("left_at") @db.Timestamptz
  createdAt      DateTime  @map("created_at") @db.Timestamptz @default(now())
  updatedAt      DateTime  @map("updated_at") @db.Timestamptz @default(now()) @updatedAt

  learners Learner[]

  @@map("teacher")
  @@schema("chat")
}

/// Who supervises which family, with history. THE input to supervisor scope.
model FamilyAssignment {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @default(dbgenerated("chat.default_organization_id()")) @map("organization_id") @db.Uuid
  familyId       String    @map("family_id") @db.Uuid
  family         Family    @relation(fields: [familyId], references: [id], onDelete: Cascade)
  staffId        String    @map("staff_id") @db.Uuid
  staff          Staff     @relation("AssignmentStaff", fields: [staffId], references: [id])
  /// primary | temporary
  kind           String
  startsAt       DateTime  @map("starts_at") @db.Timestamptz @default(now())
  endsAt         DateTime? @map("ends_at") @db.Timestamptz
  assignedBy     String?   @map("assigned_by") @db.Uuid
  reason         String
  endedAt        DateTime? @map("ended_at") @db.Timestamptz
  endedBy        String?   @map("ended_by") @db.Uuid
  endedReason    String?   @map("ended_reason")
  createdAt      DateTime  @map("created_at") @db.Timestamptz @default(now())

  @@map("family_assignment")
  @@schema("chat")
}

/// The permission vocabulary. A key not here cannot be granted.
model Permission {
  key         String @id
  description String

  roles     RolePermission[]
  overrides AccountPermissionOverride[]

  @@map("permission")
  @@schema("chat")
}

/// The default role to permission mapping. Mirrored by rbac/permissions.ts.
model RolePermission {
  role       String
  permission String
  key        Permission @relation(fields: [permission], references: [key], onDelete: Cascade)

  @@id([role, permission])
  @@map("role_permission")
  @@schema("chat")
}

/// A per-account exception. DENY beats ALLOW beats the role default.
model AccountPermissionOverride {
  id         String    @id @default(uuid()) @db.Uuid
  accountId  String    @map("account_id") @db.Uuid
  account    Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  permission String
  key        Permission @relation(fields: [permission], references: [key], onDelete: Cascade)
  effect     String
  reason     String
  grantedBy  String?   @map("granted_by") @db.Uuid
  expiresAt  DateTime? @map("expires_at") @db.Timestamptz
  createdAt  DateTime  @map("created_at") @db.Timestamptz @default(now())

  @@unique([accountId, permission], map: "account_permission_override_unique")
  @@map("account_permission_override")
  @@schema("chat")
}
