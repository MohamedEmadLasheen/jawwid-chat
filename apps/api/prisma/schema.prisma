// Jawwid Chat -- Prisma mapping layer.
//
// THE SQL MIGRATIONS IN supabase/migrations ARE AUTHORITATIVE FOR DDL.
// This file is a typed access layer mapped onto that schema; it never defines
// the schema. `npm run db:drift` proves the two agree.
//
// Enumerations are text + check constraint in SQL (AI #1's convention), so they
// surface here as String. The allowed values live in src/communication/contracts/vocab.ts.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["chat"]
}

// =====================================================================
// AI #1's tables -- read-mostly from the communication engine.
// =====================================================================

model Staff {
  /// PRD 2.3 -- organization_id on every root entity. SQL owns the DDL.
  organizationId String    @default(dbgenerated("chat.default_organization_id()")) @map("organization_id") @db.Uuid
  id             String    @id @default(uuid()) @db.Uuid
  name           String
  role           String
  presence       String    @default("offline")
  lastActivityAt DateTime? @map("last_activity_at") @db.Timestamptz
  isActive       Boolean   @default(true) @map("is_active")
  leftAt         DateTime? @map("left_at") @db.Timestamptz
  /// The login this staff member authenticates as. The column has existed in
  /// SQL since 20260905090200 (`account_id uuid unique references chat.account`);
  /// only this model was missing it, which is why PR-B adds a field and no DDL.
  accountId      String?   @unique @map("account_id") @db.Uuid
  account        Account?  @relation(fields: [accountId], references: [id])
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  ownedFamilies Family[]       @relation("FamilyOwner")
  stickyOf      Conversation[] @relation("ConversationStickyHandler")

  @@map("staff")
  @@schema("chat")
}

model Family {
  /// PRD 2.3 -- organization_id on every root entity. SQL owns the DDL.
  organizationId   String   @default(dbgenerated("chat.default_organization_id()")) @map("organization_id") @db.Uuid
  id               String   @id @default(uuid()) @db.Uuid
  displayName      String   @map("display_name")
  ownerId          String   @map("owner_id") @db.Uuid
  owner            Staff    @relation("FamilyOwner", fields: [ownerId], references: [id])
  primaryContactId String?  @map("primary_contact_id") @db.Uuid
  tier             String   @default("standard")
  state            String   @default("onboarding")
  language         String   @default("ar")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  contacts      Contact[]
  learners      Learner[]
  conversations Conversation[]

  @@map("family")
  @@schema("chat")
}

model Contact {
  /// PRD 2.3 -- organization_id on every root entity. SQL owns the DDL.
  organizationId    String   @default(dbgenerated("chat.default_organization_id()")) @map("organization_id") @db.Uuid
  id                String   @id @default(uuid()) @db.Uuid
  familyId          String   @map("family_id") @db.Uuid
  family            Family   @relation(fields: [familyId], references: [id])
  name              String
  relationship      String?
  rolePreset        String   @map("role_preset")
  canMessage        Boolean  @default(false) @map("can_message")
  canViewProgress   Boolean  @map("can_view_progress")
  canManageSchedule Boolean  @map("can_manage_schedule")
  canManageBilling  Boolean  @map("can_manage_billing")
  canManageContacts Boolean  @map("can_manage_contacts")
  canCancel         Boolean  @map("can_cancel")
  accountId         String?  @map("account_id") @db.Uuid
  account           Account? @relation(fields: [accountId], references: [id])
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("contact")
  @@schema("chat")
}

model Learner {
  /// PRD 2.3 -- organization_id on every root entity. SQL owns the DDL.
  organizationId String    @default(dbgenerated("chat.default_organization_id()")) @map("organization_id") @db.Uuid
  id             String    @id @default(uuid()) @db.Uuid
  familyId       String    @map("family_id") @db.Uuid
  family         Family    @relation(fields: [familyId], references: [id])
  name           String
  level          String?
  /// Now a real relationship: chat.teacher landed in the PR-A identity
  /// foundation and learner.teacher_id is a foreign key to it.
  teacherId      String?   @map("teacher_id") @db.Uuid
  teacher        Teacher?  @relation(fields: [teacherId], references: [id])
  nextClassAt    DateTime? @map("next_class_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  conversations Conversation[]
  notifications Notification[]

  @@map("learner")
  @@schema("chat")
}

model Config {
  key       String   @id
  value     Json
  scope     String   @default("global")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("config")
  @@schema("chat")
}

model EventLog {
  /// bigint identity, generated by the database (AI #1's definition).
  id        BigInt   @id @default(autoincrement())
  familyId  String?  @map("family_id") @db.Uuid
  actorKind String   @map("actor_type")
  actorId   String?  @map("actor_id") @db.Uuid
  type      String
  payload   Json     @default("{}")
  at        DateTime @default(now()) @db.Timestamptz

  @@map("event_log")
  @@schema("chat")
}

model AuditLog {
  /// bigint identity, generated by the database (AI #1's definition).
  id       BigInt   @id @default(autoincrement())
  actorId  String?  @map("actor_id") @db.Uuid
  action   String
  entity   String
  entityId String   @map("entity_id") @db.Uuid
  before   Json?
  after    Json?
  reason   String
  at       DateTime @default(now()) @db.Timestamptz

  @@map("audit_log")
  @@schema("chat")
}

// =====================================================================
// AI #2 -- communication domain
// =====================================================================

model Conversation {
  /// PRD 2.3 -- organization_id on every root entity. SQL owns the DDL.
  organizationId String   @default(dbgenerated("chat.default_organization_id()")) @map("organization_id") @db.Uuid
  id             String   @id @default(uuid()) @db.Uuid
  type           String
  familyId       String?  @map("family_id") @db.Uuid
  family         Family?  @relation(fields: [familyId], references: [id])
  learnerId      String?  @map("learner_id") @db.Uuid
  learner        Learner? @relation(fields: [learnerId], references: [id])
  title          String?

  /// Canonical id of a 1:1 channel; makes a duplicate direct conversation impossible.
  directKey String? @unique @map("direct_key")

  state String @default("open")

  teacherRequiresApproval Boolean @default(true) @map("teacher_requires_approval")
  parentRequiresApproval  Boolean @default(true) @map("parent_requires_approval")

  stickyHandlerId String?   @map("sticky_handler_id") @db.Uuid
  stickyHandler   Staff?    @relation("ConversationStickyHandler", fields: [stickyHandlerId], references: [id])
  stickyUntil     DateTime? @map("sticky_until") @db.Timestamptz

  /// Server-assigned monotonic message counter.
  lastSeq BigInt @default(0) @map("last_seq")

  lastCustomerMessageAt DateTime? @map("last_customer_message_at") @db.Timestamptz
  lastStaffMessageAt    DateTime? @map("last_staff_message_at") @db.Timestamptz
  lastActivityAt        DateTime  @default(now()) @map("last_activity_at") @db.Timestamptz
  resolvedAt            DateTime? @map("resolved_at") @db.Timestamptz
  archivedAt            DateTime? @map("archived_at") @db.Timestamptz
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  members       ConversationMember[]
  messages      Message[]
  approvals     MessageApproval[]
  participants  ConversationParticipantState[]
  calls         Call[]
  notifications Notification[]

  @@map("conversation")
  @@schema("chat")
}

/// The explicit participant set BR-1 is enforced against.
model ConversationMember {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @map("conversation_id") @db.Uuid
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  actorKind      String       @map("actor_kind")
  actorId        String       @map("actor_id") @db.Uuid
  memberRole     String       @map("member_role")
  isSilent       Boolean      @default(false) @map("is_silent")
  addedBy        String?      @map("added_by") @db.Uuid
  joinedAt       DateTime     @default(now()) @map("joined_at") @db.Timestamptz
  leftAt         DateTime?    @map("left_at") @db.Timestamptz

  @@map("conversation_member")
  @@schema("chat")
}

model Message {
  /// PRD 2.3 -- organization_id on every root entity. SQL owns the DDL.
  organizationId String        @default(dbgenerated("chat.default_organization_id()")) @map("organization_id") @db.Uuid
  id             String        @id @default(uuid()) @db.Uuid
  conversationId String?       @map("conversation_id") @db.Uuid
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  authorType   String  @map("author_type")
  authorId     String? @map("author_id") @db.Uuid
  onBehalfMode String? @map("on_behalf_mode")

  type       String  @default("text")
  body       String?
  visibility String
  moderation String  @default("published")
  origin     String  @default("user")

  seq BigInt?

  replyToMessageId String?   @map("reply_to_message_id") @db.Uuid
  replyTo          Message?  @relation("MessageReply", fields: [replyToMessageId], references: [id])
  replies          Message[] @relation("MessageReply")

  clientMessageId String? @map("client_message_id")

  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz
  deletedBy      String?   @map("deleted_by") @db.Uuid
  deletedForAll  Boolean   @default(false) @map("deleted_for_all")
  redactedReason String?   @map("redacted_reason")

  /// Superseded by MessageAttachment; kept because AI #1 defined it NOT NULL.
  attachmentsJson Json @default("[]") @map("attachments")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  attachments MessageAttachment[]
  reactions   MessageReaction[]
  receipts    MessageReceipt[]
  hiddenFor   MessageHiddenFor[]
  approval    MessageApproval?

  @@map("message")
  @@schema("chat")
}

model MessageAttachment {
  id                 String   @id @default(uuid()) @db.Uuid
  messageId          String   @map("message_id") @db.Uuid
  message            Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  kind               String
  objectKey          String   @unique @map("object_key")
  mimeType           String   @map("mime_type")
  byteSize           Int      @map("byte_size")
  checksumSha256     String?  @map("checksum_sha256")
  originalName       String?  @map("original_name")
  durationMs         Int?     @map("duration_ms")
  width              Int?
  height             Int?
  thumbnailObjectKey String?  @map("thumbnail_object_key")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("message_attachment")
  @@schema("chat")
}

model MessageReaction {
  id        String   @id @default(uuid()) @db.Uuid
  messageId String   @map("message_id") @db.Uuid
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  actorId   String   @map("actor_id") @db.Uuid
  emoji     String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@unique([messageId, actorId])
  @@map("message_reaction")
  @@schema("chat")
}

model MessageReceipt {
  id          String    @id @default(uuid()) @db.Uuid
  messageId   String    @map("message_id") @db.Uuid
  message     Message   @relation(fields: [messageId], references: [id], onDelete: Cascade)
  actorId     String    @map("actor_id") @db.Uuid
  state       String    @default("sent")
  sentAt      DateTime  @default(now()) @map("sent_at") @db.Timestamptz
  deliveredAt DateTime? @map("delivered_at") @db.Timestamptz
  readAt      DateTime? @map("read_at") @db.Timestamptz

  @@unique([messageId, actorId])
  @@map("message_receipt")
  @@schema("chat")
}

model MessageHiddenFor {
  messageId String   @map("message_id") @db.Uuid
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  actorId   String   @map("actor_id") @db.Uuid
  hiddenAt  DateTime @default(now()) @map("hidden_at") @db.Timestamptz

  @@id([messageId, actorId])
  @@map("message_hidden_for")
  @@schema("chat")
}

model ConversationParticipantState {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @map("conversation_id") @db.Uuid
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  actorId        String       @map("actor_id") @db.Uuid
  lastReadSeq    BigInt       @default(0) @map("last_read_seq")
  archivedAt     DateTime?    @map("archived_at") @db.Timestamptz
  mutedUntil     DateTime?    @map("muted_until") @db.Timestamptz
  pinnedAt       DateTime?    @map("pinned_at") @db.Timestamptz
  updatedAt      DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([conversationId, actorId])
  @@map("conversation_participant_state")
  @@schema("chat")
}

model MessageApproval {
  /// PRD 2.3 -- organization_id on every root entity. SQL owns the DDL.
  organizationId  String       @default(dbgenerated("chat.default_organization_id()")) @map("organization_id") @db.Uuid
  id              String       @id @default(uuid()) @db.Uuid
  messageId       String       @unique @map("message_id") @db.Uuid
  message         Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  conversationId  String       @map("conversation_id") @db.Uuid
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  requestedBy     String       @map("requested_by") @db.Uuid
  approverId      String?      @map("approver_id") @db.Uuid
  decision        String       @default("pending")
  rejectionReason String?      @map("rejection_reason")
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz
  decidedAt       DateTime?    @map("decided_at") @db.Timestamptz

  @@map("message_approval")
  @@schema("chat")
}

model OutboxEvent {
  id          String    @id @default(uuid()) @db.Uuid
  type        String
  payload     Json
  status      String    @default("pending")
  attempts    Int       @default(0)
  lastError   String?   @map("last_error")
  availableAt DateTime  @default(now()) @map("available_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  publishedAt DateTime? @map("published_at") @db.Timestamptz

  @@map("outbox_event")
  @@schema("chat")
}

model DeviceToken {
  /// PRD 2.3 -- organization_id on every root entity. SQL owns the DDL.
  organizationId String   @default(dbgenerated("chat.default_organization_id()")) @map("organization_id") @db.Uuid
  id             String   @id @default(uuid()) @db.Uuid
  actorId        String   @map("actor_id") @db.Uuid
  token          String   @unique
  platform       String
  isVoip         Boolean  @default(false) @map("is_voip")
  locale         String   @default("ar")
  isActive       Boolean  @default(true) @map("is_active")
  lastSeenAt     DateTime @default(now()) @map("last_seen_at") @db.Timestamptz
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  deliveries NotificationDelivery[]

  @@map("device_token")
  @@schema("chat")
}

model NotificationTemplate {
  /// PRD 2.3 -- organization_id on every root entity. SQL owns the DDL.
  organizationId String   @default(dbgenerated("chat.default_organization_id()")) @map("organization_id") @db.Uuid
  id             String   @id @default(uuid()) @db.Uuid
  key            String
  locale         String
  version        Int      @default(1)
  title          String
  body           String
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@unique([key, locale, version])
  @@map("notification_template")
  @@schema("chat")
}

model NotificationRule {
  /// PRD 2.3 -- organization_id on every root entity. SQL owns the DDL.
  organizationId    String   @default(dbgenerated("chat.default_organization_id()")) @map("organization_id") @db.Uuid
  key               String   @id
  eventType         String   @map("event_type")
  offsetSeconds     Int      @default(0) @map("offset_seconds")
  templateKey       String   @map("template_key")
  recipientRole     String   @map("recipient_role")
  channel           String   @default("push")
  priority          String   @default("normal")
  respectQuietHours Boolean  @default(true) @map("respect_quiet_hours")
  enabled           Boolean  @default(true)
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  notifications Notification[]

  @@map("notification_rule")
  @@schema("chat")
}

model Notification {
  /// PRD 2.3 -- organization_id on every root entity. SQL owns the DDL.
  organizationId String            @default(dbgenerated("chat.default_organization_id()")) @map("organization_id") @db.Uuid
  id             String            @id @default(uuid()) @db.Uuid
  /// THE deduplication guarantee.
  dedupeKey      String            @unique @map("dedupe_key")
  ruleKey        String?           @map("rule_key")
  rule           NotificationRule? @relation(fields: [ruleKey], references: [key])
  templateKey    String            @map("template_key")
  eventType      String            @map("event_type")
  recipientId    String            @map("recipient_id") @db.Uuid
  locale         String            @default("ar")
  channel        String            @default("push")
  priority       String            @default("normal")

  familyId       String?       @map("family_id") @db.Uuid
  conversationId String?       @map("conversation_id") @db.Uuid
  conversation   Conversation? @relation(fields: [conversationId], references: [id])
  variables      Json          @default("{}")

  /// The NOTIFICATION type (MESSAGE_RECEIVED). `eventType` above is the SYSTEM
  /// EVENT that produced it (message_published). Two different facts.
  type     String?
  category String  @default("messaging")

  /// Rendered once, at creation, and frozen. A second reschedule must not be
  /// able to rewrite what the parent was told the first time.
  title String?
  body  String?

  /// Deep link. The entity pair is durable; `deeplink` is the client route
  /// derived from it, stored so an older client need not know a newer route.
  entityType String? @map("entity_type")
  entityId   String? @map("entity_id") @db.Uuid
  deeplink   String?

  /// WHICH CHILD. A parent must never have to guess.
  learnerId String?  @map("learner_id") @db.Uuid
  learner   Learner? @relation(fields: [learnerId], references: [id])
  /// WHO it is about. An actor id, never a contact channel.
  senderId  String?  @map("sender_id") @db.Uuid

  /// Collapses a burst from one sender. NULL means "never group this".
  groupKey String? @map("group_key")

  /// Bypasses category muting. Set from the type registry, never by a caller.
  isEssential Boolean @default(false) @map("is_essential")

  announcementId String?       @map("announcement_id") @db.Uuid
  announcement   Announcement? @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  status      String    @default("scheduled")
  scheduledAt DateTime  @map("scheduled_at") @db.Timestamptz
  sentAt      DateTime? @map("sent_at") @db.Timestamptz
  deliveredAt DateTime? @map("delivered_at") @db.Timestamptz
  openedAt    DateTime? @map("opened_at") @db.Timestamptz
  /// READ is the user having seen it in the app. Not delivery, and not opened.
  readAt      DateTime? @map("read_at") @db.Timestamptz
  expiresAt   DateTime? @map("expires_at") @db.Timestamptz
  failedAt    DateTime? @map("failed_at") @db.Timestamptz
  failureCode String?   @map("failure_code")
  attempts    Int       @default(0)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  deliveries NotificationDelivery[]

  @@map("notification")
  @@schema("chat")
}

/// DELIVERY, which is not the notification. One notification may have three
/// deliveries: in-app, a push to a phone, a push to a tablet.
model NotificationDelivery {
  id             String        @id @default(uuid()) @db.Uuid
  /// Nullable: retention purges a notification while keeping its delivery
  /// record, which outlives it for support.
  notificationId String?       @map("notification_id") @db.Uuid
  notification   Notification? @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  recipientId    String        @map("recipient_id") @db.Uuid
  channel        String
  /// NULL for in_app: the channel is the account, not a device.
  deviceTokenId  String?       @map("device_token_id") @db.Uuid
  deviceToken    DeviceToken?  @relation(fields: [deviceTokenId], references: [id])
  platform       String?

  status        String    @default("pending")
  /// A suppressed push is a recorded decision, not a missing row.
  skipReason    String?   @map("skip_reason")
  attempts      Int       @default(0)
  sentAt        DateTime? @map("sent_at") @db.Timestamptz
  deliveredAt   DateTime? @map("delivered_at") @db.Timestamptz
  failedAt      DateTime? @map("failed_at") @db.Timestamptz
  nextAttemptAt DateTime? @map("next_attempt_at") @db.Timestamptz
  errorCode     String?   @map("error_code")
  errorMessage  String?   @map("error_message")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("notification_delivery")
  @@schema("chat")
}

/// The taxonomy. `isOptional = false` means the category cannot be muted.
model NotificationCategoryRow {
  organizationId String  @default(dbgenerated("chat.default_organization_id()")) @map("organization_id") @db.Uuid
  key            String  @id
  isOptional     Boolean @default(true) @map("is_optional")
  displayOrder   Int     @default(100) @map("display_order")

  preferences NotificationPreference[]

  @@map("notification_category")
  @@schema("chat")
}

/// Push only. In-app notifications are never disableable -- the centre is the
/// record of what happened, and a setting that loses it is a bug.
model NotificationPreference {
  actorId     String                  @map("actor_id") @db.Uuid
  category    String
  categoryRow NotificationCategoryRow @relation(fields: [category], references: [key])
  pushEnabled Boolean                 @default(true) @map("push_enabled")
  updatedAt   DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@id([actorId, category])
  @@map("notification_preference")
  @@schema("chat")
}

/// Academy announcements are an entity, not a special kind of push. Publishing
/// one produces ordinary notifications through the ordinary engine.
model Announcement {
  organizationId String  @default(dbgenerated("chat.default_organization_id()")) @map("organization_id") @db.Uuid
  id             String  @id @default(uuid()) @db.Uuid
  titleAr        String  @map("title_ar")
  bodyAr         String  @map("body_ar")
  titleEn        String? @map("title_en")
  bodyEn         String? @map("body_en")

  priority   String   @default("normal")
  targetType String   @map("target_type")
  targetIds  String[] @map("target_ids") @db.Uuid

  imageUrl      String? @map("image_url")
  actionLabelAr String? @map("action_label_ar")
  actionLabelEn String? @map("action_label_en")
  actionUrl     String? @map("action_url")

  status    String    @default("draft")
  publishAt DateTime  @default(now()) @map("publish_at") @db.Timestamptz
  expiresAt DateTime? @map("expires_at") @db.Timestamptz

  createdBy      String    @map("created_by") @db.Uuid
  publishedAt    DateTime? @map("published_at") @db.Timestamptz
  fannedOutAt    DateTime? @map("fanned_out_at") @db.Timestamptz
  recipientCount Int?      @map("recipient_count")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  notifications Notification[]

  @@map("announcement")
  @@schema("chat")
}

model QuietHours {
  /// PRD 2.3 -- organization_id on every root entity. SQL owns the DDL.
  organizationId String  @default(dbgenerated("chat.default_organization_id()")) @map("organization_id") @db.Uuid
  actorId        String  @id @map("actor_id") @db.Uuid
  timezone       String  @default("Africa/Cairo")
  startMinute    Int     @default(1320) @map("start_minute")
  endMinute      Int     @default(480) @map("end_minute")
  enabled        Boolean @default(true)

  @@map("quiet_hours")
  @@schema("chat")
}

model Call {
  /// PRD 2.3 -- organization_id on every root entity. SQL owns the DDL.
  organizationId  String       @default(dbgenerated("chat.default_organization_id()")) @map("organization_id") @db.Uuid
  id              String       @id @default(uuid()) @db.Uuid
  conversationId  String       @map("conversation_id") @db.Uuid
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  familyId        String?      @map("family_id") @db.Uuid
  initiatorId     String       @map("initiator_id") @db.Uuid
  type            String
  /// Server-minted. A client-supplied room name is never trusted.
  roomName        String       @unique @map("room_name")
  status          String       @default("ringing")
  outcome         String?
  startedAt       DateTime     @default(now()) @map("started_at") @db.Timestamptz
  answeredAt      DateTime?    @map("answered_at") @db.Timestamptz
  endedAt         DateTime?    @map("ended_at") @db.Timestamptz
  durationSeconds Int?         @map("duration_seconds")
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz

  participants CallParticipant[]

  @@map("call")
  @@schema("chat")
}

model CallParticipant {
  id        String    @id @default(uuid()) @db.Uuid
  callId    String    @map("call_id") @db.Uuid
  call      Call      @relation(fields: [callId], references: [id], onDelete: Cascade)
  actorId   String    @map("actor_id") @db.Uuid
  actorKind String    @map("actor_kind")
  invitedAt DateTime  @default(now()) @map("invited_at") @db.Timestamptz
  joinedAt  DateTime? @map("joined_at") @db.Timestamptz
  leftAt    DateTime? @map("left_at") @db.Timestamptz

  @@unique([callId, actorId])
  @@map("call_participant")
  @@schema("chat")
}

/// Tenant root (PRD 2.3). DDL lives in supabase/migrations/20260906120000_chat_organization.sql.
model Organization {
  id          String   @id @default(uuid()) @db.Uuid
  slug        String   @unique
  displayName String   @map("display_name")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("organization")
  @@schema("chat")
}

// =====================================================================
// Identity foundation (PR-A).
//
// docs/architecture/IDENTITY-MODEL.md is canonical; the SQL migrations
// 20260910120000/120100 own the DDL. Nothing here is exposed through a DTO:
// AccountCredential and Session hold authentication material and must never
// leave the auth service, and the mappers in
// src/communication/contracts/dto.ts enumerate their fields explicitly, so a
// model added here cannot leak into a response by accident.
// =====================================================================

/// The login identity. Carries an opaque subject and never a contact channel
/// (BR-2, guarded by db/tests/invariants.sql).
model Account {
  /// PRD 2.3 -- organization_id on every root entity. SQL owns the DDL.
  organizationId String    @default(dbgenerated("chat.default_organization_id()")) @map("organization_id") @db.Uuid
  id             String    @id @default(uuid()) @db.Uuid
  subject        String    @unique
  /// staff | family | teacher
  kind           String
  /// provisioned | active | suspended | deactivated
  status         String    @default("active")
  isActive       Boolean   @default(true) @map("is_active")
  deactivatedAt  DateTime? @map("deactivated_at") @db.Timestamptz
  deactivatedBy  String?   @map("deactivated_by") @db.Uuid
  lastLoginAt    DateTime? @map("last_login_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  credential AccountCredential?
  sessions   Session[]
  devices    Device[]
  teacher    Teacher?
  contacts   Contact[]
  staff      Staff?

  @@map("account")
  @@schema("chat")
}

/// Password material. One row per account; absence means the account cannot
/// log in with a password. Never selected outside the login path.
model AccountCredential {
  accountId         String    @id @map("account_id") @db.Uuid
  account           Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  passwordHash      String    @map("password_hash")
  passwordChangedAt DateTime  @default(now()) @map("password_changed_at") @db.Timestamptz
  failedAttempts    Int       @default(0) @map("failed_attempts")
  lockedUntil       DateTime? @map("locked_until") @db.Timestamptz
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("account_credential")
  @@schema("chat")
}

/// One row per login. The access token carries this row's id as `sid`, so
/// revoking the row ends the session on the next request.
model Session {
  organizationId   String    @default(dbgenerated("chat.default_organization_id()")) @map("organization_id") @db.Uuid
  id               String    @id @default(uuid()) @db.Uuid
  accountId        String    @map("account_id") @db.Uuid
  account          Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  deviceId         String?   @map("device_id") @db.Uuid
  device           Device?   @relation(fields: [deviceId], references: [id])
  /// Hashed. The refresh token itself is never stored.
  refreshTokenHash String    @unique @map("refresh_token_hash")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz
  lastSeenAt       DateTime? @map("last_seen_at") @db.Timestamptz
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz
  revokedBy        String?   @map("revoked_by") @db.Uuid
  revokedReason    String?   @map("revoked_reason")
  /// Hashed, never the raw address.
  ipHash           String?   @map("ip_hash")
  userAgent        String?   @map("user_agent")

  @@map("session")
  @@schema("chat")
}

/// A device an account signs in on. `name` is a label such as "iPhone" and is
/// never a phone number.
model Device {
  organizationId String   @default(dbgenerated("chat.default_organization_id()")) @map("organization_id") @db.Uuid
  id             String   @id @default(uuid()) @db.Uuid
  accountId      String   @map("account_id") @db.Uuid
  account        Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  /// ios | android | web
  platform       String
  appVersion     String?  @map("app_version")
  name           String?
  firstSeenAt    DateTime @default(now()) @map("first_seen_at") @db.Timestamptz
  lastSeenAt     DateTime @default(now()) @map("last_seen_at") @db.Timestamptz
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  sessions Session[]

  @@map("device")
  @@schema("chat")
}

/// Teacher identity. Not a staff role: `staff.role` deliberately has no
/// teacher, because the family-facing role set would then decide whether a
/// teacher may communicate (domain-reconciliation.md C).
model Teacher {
  organizationId String    @default(dbgenerated("chat.default_organization_id()")) @map("organization_id") @db.Uuid
  id             String    @id @default(uuid()) @db.Uuid
  /// Null until a login is provisioned; such a teacher can never authenticate.
  accountId      String?   @unique @map("account_id") @db.Uuid
  account        Account?  @relation(fields: [accountId], references: [id])
  name           String
  /// Set when Jawwid Core gains a teacher entity.
  coreTeacherId  String?   @unique @map("core_teacher_id") @db.Uuid
  syncedAt       DateTime? @map("synced_at") @db.Timestamptz
  isActive       Boolean   @default(true) @map("is_active")
  leftAt         DateTime? @map("left_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  learners Learner[]

  @@map("teacher")
  @@schema("chat")
}
