// Jawwid Chat -- Prisma mapping layer.
//
// THE SQL MIGRATIONS IN supabase/migrations ARE AUTHORITATIVE FOR DDL.
// This file is a typed access layer mapped onto that schema; it never defines
// the schema. `npm run db:drift` proves the two agree.
//
// Enumerations are text + check constraint in SQL (AI #1's convention), so they
// surface here as String. The allowed values live in src/communication/contracts/vocab.ts.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["chat"]
}

// =====================================================================
// AI #1's tables -- read-mostly from the communication engine.
// =====================================================================

model Staff {
  /// PRD 2.3 -- organization_id on every root entity. SQL owns the DDL.
  organizationId String @default(dbgenerated("chat.default_organization_id()")) @map("organization_id") @db.Uuid
  id             String    @id @default(uuid()) @db.Uuid
  name           String
  /// Private object-storage key for this staff member's photo, set by that staff member.
  /// Never a URL: reads are short-lived signed URLs minted per request.
  avatarObjectKey String?  @map("avatar_object_key")
  role           String
  presence       String    @default("offline")
  lastActivityAt DateTime? @map("last_activity_at") @db.Timestamptz
  isActive       Boolean   @map("is_active") @default(true)
  leftAt         DateTime? @map("left_at") @db.Timestamptz
  /// The login this staff member authenticates as. The column has existed in
  /// SQL since 20260905090200 (`account_id uuid unique references chat.account`);
  /// only this model was missing it, which is why PR-B adds a field and no DDL.
  accountId      String?   @unique @map("account_id") @db.Uuid
  account        Account?  @relation(fields: [accountId], references: [id])
  createdAt      DateTime  @map("created_at") @db.Timestamptz @default(now())
  updatedAt      DateTime  @map("updated_at") @db.Timestamptz @default(now()) @updatedAt

  ownedFamilies  Family[]        @relation("FamilyOwner")
  stickyOf       Conversation[]  @relation("ConversationStickyHandler")

  storiesCreated   Story[] @relation("StoryCreatedBy")
  storiesPublished Story[] @relation("StoryPublishedBy")
  storiesDeleted   Story[] @relation("StoryDeletedBy")

  profile         StaffProfile?
  responsibilities StaffResponsibility[] @relation("ResponsibilityHolder")
  reportingLine   StaffReportingLine?   @relation("ReportingLineMember")
  directReports   StaffReportingLine[]  @relation("ReportingLineManager")

  @@map("staff")
  @@schema("chat")
}

model Family {
  /// PRD 2.3 -- organization_id on every root entity. SQL owns the DDL.
  organizationId String @default(dbgenerated("chat.default_organization_id()")) @map("organization_id") @db.Uuid
  id               String   @id @default(uuid()) @db.Uuid
  displayName      String   @map("display_name")
  ownerId          String   @map("owner_id") @db.Uuid
  owner            Staff    @relation("FamilyOwner", fields: [ownerId], references: [id])
  primaryContactId String?  @map("primary_contact_id") @db.Uuid
  tier             String   @default("standard")
  state            String   @default("onboarding")
  language         String   @default("ar")
  /// Story targeting (20261017120000). Owned by Jawwid Core; an admin sets them
  /// until the Core projection writes them. ISO 3166-1 alpha-2.
  countryCode            String?   @map("country_code")
  /// Length of the subscription PLAN in months: 1, 3, 6 or 12.
  subscriptionPlanMonths Int?      @map("subscription_plan_months") @db.SmallInt
  /// admin | core -- who last wrote the two columns above.
  segmentSource          String?   @map("segment_source")
  segmentUpdatedAt       DateTime? @map("segment_updated_at") @db.Timestamptz
  createdAt        DateTime @map("created_at") @db.Timestamptz @default(now())
  updatedAt        DateTime @map("updated_at") @db.Timestamptz @default(now()) @updatedAt

  contacts      Contact[]
  learners      Learner[]
  conversations Conversation[]

  @@map("family")
  @@schema("chat")
}

model Contact {
  /// PRD 2.3 -- organization_id on every root entity. SQL owns the DDL.
  organizationId String @default(dbgenerated("chat.default_organization_id()")) @map("organization_id") @db.Uuid
  id                String   @id @default(uuid()) @db.Uuid
  familyId          String   @map("family_id") @db.Uuid
  family            Family   @relation(fields: [familyId], references: [id])
  name              String
  relationship      String?
  rolePreset        String   @map("role_preset")
  canMessage        Boolean  @map("can_message") @default(false)
  canViewProgress   Boolean  @map("can_view_progress")
  canManageSchedule Boolean  @map("can_manage_schedule")
  canManageBilling  Boolean  @map("can_manage_billing")
  canManageContacts Boolean  @map("can_manage_contacts")
  canCancel         Boolean  @map("can_cancel")
  accountId         String?  @map("account_id") @db.Uuid
  account           Account? @relation(fields: [accountId], references: [id])
  /// A profile photo: `avatars/<kind>/<this id>/<uuid>` (CHECK in 20261014130000). Never sent to a client; served as a signed /media/avatars URL.
  avatarObjectKey String?  @map("avatar_object_key")
  isActive          Boolean  @map("is_active") @default(true)
  createdAt         DateTime @map("created_at") @db.Timestamptz @default(now())
  updatedAt         DateTime @map("updated_at") @db.Timestamptz @default(now()) @updatedAt

  @@map("contact")
  @@schema("chat")
}

model Learner {
  /// PRD 2.3 -- organization_id on every root entity. SQL owns the DDL.
  organizationId String @default(dbgenerated("chat.default_organization_id()")) @map("organization_id") @db.Uuid
  id          String    @id @default(uuid()) @db.Uuid
  familyId    String    @map("family_id") @db.Uuid
  family      Family    @relation(fields: [familyId], references: [id])
  name        String
  level       String?
  /// Now a real relationship: chat.teacher landed in the PR-A identity
  /// foundation and learner.teacher_id is a foreign key to it.
  teacherId   String?   @map("teacher_id") @db.Uuid
  teacher     Teacher?  @relation(fields: [teacherId], references: [id])
  /// A profile photo: `avatars/<kind>/<this id>/<uuid>` (CHECK in 20261014130000). Never sent to a client; served as a signed /media/avatars URL.
  avatarObjectKey String?  @map("avatar_object_key")
  nextClassAt DateTime? @map("next_class_at") @db.Timestamptz
  createdAt   DateTime  @map("created_at") @db.Timestamptz @default(now())
  updatedAt   DateTime  @map("updated_at") @db.Timestamptz @default(now()) @updatedAt

  conversations Conversation[]
  lessons       Lesson[]

  @@map("learner")
  @@schema("chat")
}

model Config {
  key       String   @id
  value     Json
  scope     String   @default("global")
  updatedAt DateTime @map("updated_at") @db.Timestamptz @default(now()) @updatedAt

  @@map("config")
  @@schema("chat")
}

model EventLog {
  /// bigint identity, generated by the database (AI #1's definition).
  id        BigInt   @id @default(autoincrement())
  familyId  String?  @map("family_id") @db.Uuid
  actorKind String   @map("actor_type")
  actorId   String?  @map("actor_id") @db.Uuid
  type      String
  payload   Json     @default("{}")
  at        DateTime @db.Timestamptz @default(now())

  @@map("event_log")
  @@schema("chat")
}

model AuditLog {
  /// bigint identity, generated by the database (AI #1's definition).
  id       BigInt   @id @default(autoincrement())
  actorId  String?  @map("actor_id") @db.Uuid
  action   String
  entity   String
  entityId String   @map("entity_id") @db.Uuid
  before   Json?
  after    Json?
  reason   String
  at       DateTime @db.Timestamptz @default(now())

  @@map("audit_log")
  @@schema("chat")
}

// =====================================================================
// AI #2 -- communication domain
// =====================================================================

model Conversation {
  /// PRD 2.3 -- organization_id on every root entity. SQL owns the DDL.
  organizationId String @default(dbgenerated("chat.default_organization_id()")) @map("organization_id") @db.Uuid
  id        String  @id @default(uuid()) @db.Uuid
  type      String
  familyId  String? @map("family_id") @db.Uuid
  family    Family? @relation(fields: [familyId], references: [id])
  learnerId String? @map("learner_id") @db.Uuid
  learner   Learner? @relation(fields: [learnerId], references: [id])
  title     String?

  /// Canonical id of a 1:1 channel; makes a duplicate direct conversation impossible.
  directKey String? @unique @map("direct_key")

  /// PD-11/PD-12: the teacher a teacher_supervision conversation is about (that type only).
  supervisedTeacherId String? @map("supervised_teacher_id") @db.Uuid

  /// PD-11 T4: the teacher a trial_group conversation belongs to (that type only).
  trialTeacherId String? @map("trial_teacher_id") @db.Uuid

  state String @default("open")

  teacherRequiresApproval Boolean @map("teacher_requires_approval") @default(true)
  parentRequiresApproval  Boolean @map("parent_requires_approval") @default(true)

  stickyHandlerId String?   @map("sticky_handler_id") @db.Uuid
  stickyHandler   Staff?    @relation("ConversationStickyHandler", fields: [stickyHandlerId], references: [id])
  stickyUntil     DateTime? @map("sticky_until") @db.Timestamptz

  /// Server-assigned monotonic message counter.
  lastSeq BigInt @map("last_seq") @default(0)

  lastCustomerMessageAt DateTime? @map("last_customer_message_at") @db.Timestamptz
  lastStaffMessageAt    DateTime? @map("last_staff_message_at") @db.Timestamptz
  lastActivityAt        DateTime  @map("last_activity_at") @db.Timestamptz @default(now())
  resolvedAt            DateTime? @map("resolved_at") @db.Timestamptz
  archivedAt            DateTime? @map("archived_at") @db.Timestamptz
  createdAt             DateTime  @map("created_at") @db.Timestamptz @default(now())
  updatedAt             DateTime  @map("updated_at") @db.Timestamptz @default(now()) @updatedAt

  members      ConversationMember[]
  messages     Message[]
  approvals    MessageApproval[]
  participants ConversationParticipantState[]
  calls        Call[]
  notifications Notification[]

  @@map("conversation")
  @@schema("chat")
}

/// The explicit participant set BR-1 is enforced against.
model ConversationMember {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @map("conversation_id") @db.Uuid
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  actorKind      String       @map("actor_kind")
  actorId        String       @map("actor_id") @db.Uuid
  memberRole     String       @map("member_role")
  isSilent       Boolean      @map("is_silent") @default(false)
  addedBy        String?      @map("added_by") @db.Uuid
  joinedAt       DateTime     @map("joined_at") @db.Timestamptz @default(now())
  leftAt         DateTime?    @map("left_at") @db.Timestamptz

  @@map("conversation_member")
  @@schema("chat")
}

model Message {
  /// PRD 2.3 -- organization_id on every root entity. SQL owns the DDL.
  organizationId String @default(dbgenerated("chat.default_organization_id()")) @map("organization_id") @db.Uuid
  id             String        @id @default(uuid()) @db.Uuid
  conversationId String?       @map("conversation_id") @db.Uuid
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  authorType   String  @map("author_type")
  authorId     String? @map("author_id") @db.Uuid
  onBehalfMode String? @map("on_behalf_mode")

  type       String @default("text")
  body       String?
  visibility String
  moderation String @default("published")
  origin     String @default("user")

  seq BigInt?

  replyToMessageId String?   @map("reply_to_message_id") @db.Uuid
  /// A forward (20261020100000); `forwardedFromMessageId` is audit-only provenance, never sent to a client.
  forwarded              Boolean @default(false)
  forwardedFromMessageId String? @map("forwarded_from_message_id") @db.Uuid
  replyTo          Message?  @relation("MessageReply", fields: [replyToMessageId], references: [id])
  replies          Message[] @relation("MessageReply")

  clientMessageId String? @map("client_message_id")

  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz
  deletedBy      String?   @map("deleted_by") @db.Uuid
  deletedForAll  Boolean   @map("deleted_for_all") @default(false)
  redactedReason String?   @map("redacted_reason")

  /// Superseded by MessageAttachment; kept because AI #1 defined it NOT NULL.
  attachmentsJson Json @map("attachments") @default("[]")

  createdAt DateTime @map("created_at") @db.Timestamptz @default(now())

  attachments MessageAttachment[]
  /// PD-11: the structured half of a message of type `card`.
  card        MessageCard?
  reactions   MessageReaction[]
  receipts    MessageReceipt[]
  hiddenFor   MessageHiddenFor[]
  approval    MessageApproval?

  @@map("message")
  @@schema("chat")
}

model MessageAttachment {
  id                 String   @id @default(uuid()) @db.Uuid
  messageId          String   @map("message_id") @db.Uuid
  message            Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  kind               String
  objectKey          String   @unique @map("object_key")
  mimeType           String   @map("mime_type")
  byteSize           Int      @map("byte_size")
  checksumSha256     String?  @map("checksum_sha256")
  originalName       String?  @map("original_name")
  durationMs         Int?     @map("duration_ms")
  width              Int?
  height             Int?
  thumbnailObjectKey String?  @map("thumbnail_object_key")
  createdAt          DateTime @map("created_at") @db.Timestamptz @default(now())

  @@map("message_attachment")
  @@schema("chat")
}

model MessageReaction {
  id        String   @id @default(uuid()) @db.Uuid
  messageId String   @map("message_id") @db.Uuid
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  actorId   String   @map("actor_id") @db.Uuid
  emoji     String
  createdAt DateTime @map("created_at") @db.Timestamptz @default(now())

  @@unique([messageId, actorId])
  @@map("message_reaction")
  @@schema("chat")
}

/// A private bookmark (20261020090000). SQL owns the DDL; no relation fields so
/// the Message model stays untouched -- rows cascade with their message.
model MessageStar {
  messageId String   @map("message_id") @db.Uuid
  actorId   String   @map("actor_id") @db.Uuid
  starredAt DateTime @default(now()) @map("starred_at") @db.Timestamptz

  @@id([messageId, actorId])
  @@map("message_star")
  @@schema("chat")
}

/// A message pinned for everyone in its conversation; at most three (trigger
/// chat.enforce_message_pin, 20261020090000).
model MessagePin {
  conversationId String   @map("conversation_id") @db.Uuid
  messageId      String   @map("message_id") @db.Uuid
  pinnedBy       String   @map("pinned_by") @db.Uuid
  pinnedByKind   String   @map("pinned_by_kind")
  pinnedAt       DateTime @default(now()) @map("pinned_at") @db.Timestamptz

  @@id([conversationId, messageId])
  @@map("message_pin")
  @@schema("chat")
}

model MessageReceipt {
  id          String    @id @default(uuid()) @db.Uuid
  messageId   String    @map("message_id") @db.Uuid
  message     Message   @relation(fields: [messageId], references: [id], onDelete: Cascade)
  actorId     String    @map("actor_id") @db.Uuid
  state       String    @default("sent")
  sentAt      DateTime  @map("sent_at") @db.Timestamptz @default(now())
  deliveredAt DateTime? @map("delivered_at") @db.Timestamptz
  readAt      DateTime? @map("read_at") @db.Timestamptz

  @@unique([messageId, actorId])
  @@map("message_receipt")
  @@schema("chat")
}

model MessageHiddenFor {
  messageId String   @map("message_id") @db.Uuid
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  actorId   String   @map("actor_id") @db.Uuid
  hiddenAt  DateTime @map("hidden_at") @db.Timestamptz @default(now())

  @@id([messageId, actorId])
  @@map("message_hidden_for")
  @@schema("chat")
}

model ConversationParticipantState {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @map("conversation_id") @db.Uuid
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  actorId        String       @map("actor_id") @db.Uuid
  lastReadSeq    BigInt       @map("last_read_seq") @default(0)
  archivedAt     DateTime?    @map("archived_at") @db.Timestamptz
  mutedUntil     DateTime?    @map("muted_until") @db.Timestamptz
  pinnedAt       DateTime?    @map("pinned_at") @db.Timestamptz
  updatedAt      DateTime     @map("updated_at") @db.Timestamptz @default(now()) @updatedAt

  @@unique([conversationId, actorId])
  @@map("conversation_participant_state")
  @@schema("chat")
}

model MessageApproval {
  /// PRD 2.3 -- organization_id on every root entity. SQL owns the DDL.
  organizationId String @default(dbgenerated("chat.default_organization_id()")) @map("organization_id") @db.Uuid
  id              String       @id @default(uuid()) @db.Uuid
  messageId       String       @unique @map("message_id") @db.Uuid
  message         Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  conversationId  String       @map("conversation_id") @db.Uuid
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  requestedBy     String       @map("requested_by") @db.Uuid
  approverId      String?      @map("approver_id") @db.Uuid
  decision        String       @default("pending")
  rejectionReason String?      @map("rejection_reason")
  createdAt       DateTime     @map("created_at") @db.Timestamptz @default(now())
  decidedAt       DateTime?    @map("decided_at") @db.Timestamptz

  @@map("message_approval")
  @@schema("chat")
}

model OutboxEvent {
  id          String    @id @default(uuid()) @db.Uuid
  type        String
  payload     Json
  status      String    @default("pending")
  attempts    Int       @default(0)
  lastError   String?   @map("last_error")
  availableAt DateTime  @map("available_at") @db.Timestamptz @default(now())
  createdAt   DateTime  @map("created_at") @db.Timestamptz @default(now())
  publishedAt DateTime? @map("published_at") @db.Timestamptz

  @@map("outbox_event")
  @@schema("chat")
}

model DeviceToken {
  /// PRD 2.3 -- organization_id on every root entity. SQL owns the DDL.
  organizationId String @default(dbgenerated("chat.default_organization_id()")) @map("organization_id") @db.Uuid
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String   @map("actor_id") @db.Uuid
  token      String   @unique
  platform   String
  isVoip     Boolean  @map("is_voip") @default(false)
  locale     String   @default("ar")
  isActive   Boolean  @map("is_active") @default(true)
  lastSeenAt DateTime @map("last_seen_at") @db.Timestamptz @default(now())
  createdAt  DateTime @map("created_at") @db.Timestamptz @default(now())

  @@map("device_token")
  @@schema("chat")
}

model NotificationTemplate {
  /// PRD 2.3 -- organization_id on every root entity. SQL owns the DDL.
  organizationId String @default(dbgenerated("chat.default_organization_id()")) @map("organization_id") @db.Uuid
  id        String   @id @default(uuid()) @db.Uuid
  key       String
  locale    String
  version   Int      @default(1)
  title     String
  body      String
  isActive  Boolean  @map("is_active") @default(true)
  createdAt DateTime @map("created_at") @db.Timestamptz @default(now())

  @@unique([key, locale, version])
  @@map("notification_template")
  @@schema("chat")
}

model NotificationRule {
  /// PRD 2.3 -- organization_id on every root entity. SQL owns the DDL.
  organizationId String @default(dbgenerated("chat.default_organization_id()")) @map("organization_id") @db.Uuid
  key               String   @id
  eventType         String   @map("event_type")
  offsetSeconds     Int      @map("offset_seconds") @default(0)
  templateKey       String   @map("template_key")
  recipientRole     String   @map("recipient_role")
  channel           String   @default("push")
  priority          String   @default("normal")
  respectQuietHours Boolean  @map("respect_quiet_hours") @default(true)
  enabled           Boolean  @default(true)
  updatedAt         DateTime @map("updated_at") @db.Timestamptz @default(now()) @updatedAt

  notifications Notification[]

  @@map("notification_rule")
  @@schema("chat")
}

model Notification {
  /// PRD 2.3 -- organization_id on every root entity. SQL owns the DDL.
  organizationId String @default(dbgenerated("chat.default_organization_id()")) @map("organization_id") @db.Uuid
  id          String  @id @default(uuid()) @db.Uuid
  /// THE deduplication guarantee.
  dedupeKey   String  @unique @map("dedupe_key")
  ruleKey     String? @map("rule_key")
  rule        NotificationRule? @relation(fields: [ruleKey], references: [key])
  templateKey String  @map("template_key")
  eventType   String  @map("event_type")
  recipientId String  @map("recipient_id") @db.Uuid
  locale      String  @default("ar")
  channel     String  @default("push")
  priority    String  @default("normal")

  familyId       String?       @map("family_id") @db.Uuid
  conversationId String?       @map("conversation_id") @db.Uuid
  conversation   Conversation? @relation(fields: [conversationId], references: [id])
  variables      Json    @default("{}")

  status      String    @default("scheduled")
  scheduledAt DateTime  @map("scheduled_at") @db.Timestamptz
  sentAt      DateTime? @map("sent_at") @db.Timestamptz
  deliveredAt DateTime? @map("delivered_at") @db.Timestamptz
  openedAt    DateTime? @map("opened_at") @db.Timestamptz
  failedAt    DateTime? @map("failed_at") @db.Timestamptz
  failureCode String?   @map("failure_code")
  attempts    Int       @default(0)
  createdAt   DateTime  @map("created_at") @db.Timestamptz @default(now())

  @@map("notification")
  @@schema("chat")
}

model QuietHours {
  /// PRD 2.3 -- organization_id on every root entity. SQL owns the DDL.
  organizationId String @default(dbgenerated("chat.default_organization_id()")) @map("organization_id") @db.Uuid
  actorId     String  @id @map("actor_id") @db.Uuid
  timezone    String  @default("Africa/Cairo")
  startMinute Int     @map("start_minute") @default(1320)
  endMinute   Int     @map("end_minute") @default(480)
  enabled     Boolean @default(true)

  @@map("quiet_hours")
  @@schema("chat")
}

model Call {
  /// PRD 2.3 -- organization_id on every root entity. SQL owns the DDL.
  organizationId String @default(dbgenerated("chat.default_organization_id()")) @map("organization_id") @db.Uuid
  id              String       @id @default(uuid()) @db.Uuid
  conversationId  String       @map("conversation_id") @db.Uuid
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  familyId        String?      @map("family_id") @db.Uuid
  initiatorId     String       @map("initiator_id") @db.Uuid
  type            String
  /// Server-minted. A client-supplied room name is never trusted.
  roomName        String       @unique @map("room_name")
  status          String       @default("ringing")
  outcome         String?
  startedAt       DateTime     @map("started_at") @db.Timestamptz @default(now())
  answeredAt      DateTime?    @map("answered_at") @db.Timestamptz
  endedAt         DateTime?    @map("ended_at") @db.Timestamptz
  durationSeconds Int?         @map("duration_seconds")
  createdAt       DateTime     @map("created_at") @db.Timestamptz @default(now())

  participants CallParticipant[]

  @@map("call")
  @@schema("chat")
}

model CallParticipant {
  id        String    @id @default(uuid()) @db.Uuid
  callId    String    @map("call_id") @db.Uuid
  call      Call      @relation(fields: [callId], references: [id], onDelete: Cascade)
  actorId   String    @map("actor_id") @db.Uuid
  actorKind String    @map("actor_kind")
  invitedAt DateTime  @map("invited_at") @db.Timestamptz @default(now())
  /// APPLICATION accept (`POST /calls/:id/accept`). Not media presence.
  joinedAt  DateTime? @map("joined_at") @db.Timestamptz
  /// APPLICATION departure: decline, or end() closing an open participant.
  leftAt    DateTime? @map("left_at") @db.Timestamptz
  /// MEDIA presence, from the LiveKit webhook's own event timestamp. Distinct
  /// from joinedAt on purpose -- accepting a call and reaching the room are two
  /// different facts, and only LiveKit knows the second.
  mediaJoinedAt DateTime? @map("media_joined_at") @db.Timestamptz
  mediaLeftAt   DateTime? @map("media_left_at") @db.Timestamptz

  @@unique([callId, actorId])
  @@map("call_participant")
  @@schema("chat")
}

/// Tenant root (PRD 2.3). DDL lives in supabase/migrations/20260906120000_chat_organization.sql.
model Organization {
