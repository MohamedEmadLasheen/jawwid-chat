// Identity foundation (PR-A).
//
// docs/architecture/IDENTITY-MODEL.md is canonical; the SQL migrations
// 20260910120000/120100 own the DDL. Nothing here is exposed through a DTO:
// AccountCredential and Session hold authentication material and must never
// leave the auth service, and the mappers in
// src/communication/contracts/dto.ts enumerate their fields explicitly, so a
// model added here cannot leak into a response by accident.
// =====================================================================

/// The login identity. Carries an opaque subject and never a contact channel
/// (BR-2, guarded by db/tests/invariants.sql).
model Account {
  /// PRD 2.3 -- organization_id on every root entity. SQL owns the DDL.
  organizationId String    @default(dbgenerated("chat.default_organization_id()")) @map("organization_id") @db.Uuid
  id             String    @id @default(uuid()) @db.Uuid
  subject        String    @unique
  /// staff | family | teacher
  kind           String
  /// provisioned | active | suspended | deactivated
  status         String    @default("active")
  isActive       Boolean   @default(true) @map("is_active")
  deactivatedAt  DateTime? @map("deactivated_at") @db.Timestamptz
  deactivatedBy  String?   @map("deactivated_by") @db.Uuid
  lastLoginAt    DateTime? @map("last_login_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  credential AccountCredential?
  sessions   Session[]
  devices    Device[]
  teacher    Teacher?
  contacts   Contact[]
  staff      Staff?

  @@map("account")
  @@schema("chat")
}

/// Password material. One row per account; absence means the account cannot
/// log in with a password. Never selected outside the login path.
model AccountCredential {
  accountId         String    @id @map("account_id") @db.Uuid
  account           Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  passwordHash      String    @map("password_hash")
  passwordChangedAt DateTime  @default(now()) @map("password_changed_at") @db.Timestamptz
  failedAttempts    Int       @default(0) @map("failed_attempts")
  lockedUntil       DateTime? @map("locked_until") @db.Timestamptz
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("account_credential")
  @@schema("chat")
}

/// One row per login. The access token carries this row's id as `sid`, so
/// revoking the row ends the session on the next request.
model Session {
  organizationId   String    @default(dbgenerated("chat.default_organization_id()")) @map("organization_id") @db.Uuid
  id               String    @id @default(uuid()) @db.Uuid
  accountId        String    @map("account_id") @db.Uuid
  account          Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  deviceId         String?   @map("device_id") @db.Uuid
  device           Device?   @relation(fields: [deviceId], references: [id])
  /// Hashed. The refresh token itself is never stored.
  refreshTokenHash String    @unique @map("refresh_token_hash")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz
  lastSeenAt       DateTime? @map("last_seen_at") @db.Timestamptz
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz
  revokedBy        String?   @map("revoked_by") @db.Uuid
  revokedReason    String?   @map("revoked_reason")
  /// Hashed, never the raw address.
  ipHash           String?   @map("ip_hash")
  userAgent        String?   @map("user_agent")
  /// PD-21: this session is a support session (an administrator acting as the account).
  impersonationId  String?   @unique @map("impersonation_id") @db.Uuid
  /// PD-23: when the password for this login chain was entered; copied on rotation.
  authenticatedAt  DateTime  @default(now()) @map("authenticated_at") @db.Timestamptz
  /// PD-23: app | web.
  client           String?
  /// PD-23: Admin Web "keep me signed in on this device".
  remembered       Boolean   @default(false)

  @@map("session")
  @@schema("chat")
}

/// A device an account signs in on. `name` is a label such as "iPhone" and is
