/// PD-9 / PD-11: one lesson occurrence. SQL owns the DDL and every rule
/// (20261018120000): born open, closed once, never deleted.
model Lesson {
  id                   String         @id @default(uuid()) @db.Uuid
  organizationId       String         @default(dbgenerated("chat.default_organization_id()")) @map("organization_id") @db.Uuid
  /// Null for a trial (kind = 'trial'), which is for a prospect instead.
  learnerId            String?        @map("learner_id") @db.Uuid
  learner              Learner?       @relation(fields: [learnerId], references: [id])
  prospectId           String?        @map("prospect_id") @db.Uuid
  prospect             TrialProspect? @relation(fields: [prospectId], references: [id])
  teacherId            String         @map("teacher_id") @db.Uuid
  teacher              Teacher        @relation(fields: [teacherId], references: [id])
  kind                 String         @default("regular")
  makeupFor            String?        @map("makeup_for") @db.Uuid
  startsAt             DateTime       @map("starts_at") @db.Timestamptz
  endsAt               DateTime       @map("ends_at") @db.Timestamptz
  outcome              String?
  outcomeNote          String?        @map("outcome_note")
  outcomeByKind        String?        @map("outcome_by_kind")
  outcomeBy            String?        @map("outcome_by") @db.Uuid
  outcomeAt            DateTime?      @map("outcome_at") @db.Timestamptz
  /// PD-15: a student apology's `before_start` / `after_start`. Written by chat.guard_lesson only.
  apologyTiming        String?        @map("apology_timing")
  /// staff / contact (a make-up the family booked) / teacher (PD-15: a make-up the
  /// teacher booked) / system (materialized from a slot).
  createdByKind        String         @default("staff") @map("created_by_kind")
  createdBy            String?        @map("created_by") @db.Uuid
  scheduleSlotId       String?        @map("schedule_slot_id") @db.Uuid
  /// PD-31: the lesson this one replaces after a move (that row is rescheduled). Insert only.
  movedFrom            String?        @unique @map("moved_from") @db.Uuid
  movedFromLesson      Lesson?        @relation("LessonMove", fields: [movedFrom], references: [id])
  /// PD-31: the lesson that replaced this one, when it was moved.
  movedToLesson        Lesson?        @relation("LessonMove")
  remindersScheduledAt DateTime?      @map("reminders_scheduled_at") @db.Timestamptz
  createdAt            DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  report       LessonReport?
  rulings      LessonRuling[]
  trialOutcome TrialOutcome?
  corrections  LessonCorrection[]

  @@map("lesson")
  @@schema("chat")
}

model LessonReport {
  lessonId       String    @id @map("lesson_id") @db.Uuid
  lesson         Lesson    @relation(fields: [lessonId], references: [id])
  organizationId String    @default(dbgenerated("chat.default_organization_id()")) @map("organization_id") @db.Uuid
  teacherId      String    @map("teacher_id") @db.Uuid
  /// PD-15: optional once a topic is chosen (lesson_report_says_what_was_covered).
  covered        String?
  homework       String?
  /// The performance level, 1 (needs work) .. 5 (excellent).
  rating         Int?      @db.SmallInt
  /// PD-15: staff-only -- never on the card.
  note           String?
  messageId      String?   @unique @map("message_id") @db.Uuid
  submittedAt    DateTime  @default(now()) @map("submitted_at") @db.Timestamptz
  /// PD-15 quick-report fields.
  lessonNumber   Int?      @map("lesson_number")
  /// PD-30: the M of "Lesson N of M" -- the current subscription's lessons when the report was written.
  lessonTotal    Int?      @map("lesson_total")
  coveredTopics  String[]  @default([]) @map("covered_topics")
  nextTasks      String[]  @default([]) @map("next_tasks")
  enteredByKind  String    @default("teacher") @map("entered_by_kind")
  /// Never null in the database: chat.guard_lesson_report fills it with the teacher when a writer leaves it out.
  enteredBy      String?   @map("entered_by") @db.Uuid
  /// Raised by chat.guard_lesson_report on every revision; never written by the API.
  version        Int       @default(1)
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz
  deletedBy      String?   @map("deleted_by") @db.Uuid
  deleteReason   String?   @map("delete_reason")

  revisions LessonReportRevision[]

  @@map("lesson_report")
  @@schema("chat")
}

/// PD-15: each previous version of a report. Append-only (20261021120000).
model LessonReportRevision {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
