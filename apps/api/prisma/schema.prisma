  staffId        String   @id @map("staff_id") @db.Uuid
  staff          Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  organizationId String   @default(dbgenerated("chat.default_organization_id()")) @map("organization_id") @db.Uuid
  jobTitle       String?  @map("job_title")
  about          String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  updatedBy      String?  @map("updated_by") @db.Uuid

  @@map("staff_profile")
  @@schema("chat")
}

/// An official responsibility LABEL. Ended, never edited or deleted.
model StaffResponsibility {
  id             String    @id @default(uuid()) @db.Uuid
