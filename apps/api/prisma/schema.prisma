// Jawwid Chat -- Prisma mapping layer.
//
// THE SQL MIGRATIONS IN supabase/migrations ARE AUTHORITATIVE FOR DDL.
// This file is a typed access layer mapped onto that schema; it never defines
// the schema. `npm run db:drift` proves the two agree.
//
// Enumerations are text + check constraint in SQL (AI #1's convention), so they
// surface here as String. The allowed values live in src/communication/contracts/vocab.ts.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["chat"]
}

// =====================================================================
// AI #1's tables -- read-mostly from the communication engine.
// =====================================================================

model Staff {
  /// PRD 2.3 -- organization_id on every root entity. SQL owns the DDL.
  organizationId  String    @default(dbgenerated("chat.default_organization_id()")) @map("organization_id") @db.Uuid
  id              String    @id @default(uuid()) @db.Uuid
  name            String
  /// Private object-storage key for this staff member's photo, set by that staff member.
  /// Never a URL: reads are short-lived signed URLs minted per request.
  avatarObjectKey String?   @map("avatar_object_key")
  role            String
  presence        String    @default("offline")
  lastActivityAt  DateTime? @map("last_activity_at") @db.Timestamptz
  /// PD-37: hide my last seen from other staff (and, reciprocally, see nobody's). 20261026180001.
  /// Not to be confused with `presence` above, the coverage engine's on-duty state.
  hideLastSeen    Boolean   @default(false) @map("hide_last_seen")
  isActive        Boolean   @default(true) @map("is_active")
  leftAt          DateTime? @map("left_at") @db.Timestamptz
  /// The login this staff member authenticates as. The column has existed in
  /// SQL since 20260905090200 (`account_id uuid unique references chat.account`);
  /// only this model was missing it, which is why PR-B adds a field and no DDL.
  accountId       String?   @unique @map("account_id") @db.Uuid
  account         Account?  @relation(fields: [accountId], references: [id])
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  ownedFamilies Family[]       @relation("FamilyOwner")
  stickyOf      Conversation[] @relation("ConversationStickyHandler")

  storiesCreated   Story[] @relation("StoryCreatedBy")
  storiesPublished Story[] @relation("StoryPublishedBy")
  storiesDeleted   Story[] @relation("StoryDeletedBy")

  profile                     StaffProfile?
  responsibilities            StaffResponsibility[]       @relation("ResponsibilityHolder")
  reportingLine               StaffReportingLine?         @relation("ReportingLineMember")
  directReports               StaffReportingLine[]        @relation("ReportingLineManager")
  teacherCertificatesReviewed TeacherProfileCertificate[] @relation("TeacherCertificateReviewer")

  @@map("staff")
  @@schema("chat")
}

model Family {
  /// PRD 2.3 -- organization_id on every root entity. SQL owns the DDL.
  organizationId         String    @default(dbgenerated("chat.default_organization_id()")) @map("organization_id") @db.Uuid
  id                     String    @id @default(uuid()) @db.Uuid
  displayName            String    @map("display_name")
  ownerId                String    @map("owner_id") @db.Uuid
  owner                  Staff     @relation("FamilyOwner", fields: [ownerId], references: [id])
  primaryContactId       String?   @map("primary_contact_id") @db.Uuid
  tier                   String    @default("standard")
  state                  String    @default("onboarding")
  language               String    @default("ar")
  /// Story targeting (20261017120000). Owned by Jawwid Core; an admin sets them
  /// until the Core projection writes them. ISO 3166-1 alpha-2.
  countryCode            String?   @map("country_code")
  /// Length of the subscription PLAN in months: 1, 3, 6 or 12.
  subscriptionPlanMonths Int?      @map("subscription_plan_months") @db.SmallInt
  /// admin | core -- who last wrote the two columns above.
  segmentSource          String?   @map("segment_source")
  segmentUpdatedAt       DateTime? @map("segment_updated_at") @db.Timestamptz
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  contacts      Contact[]
  learners      Learner[]
  conversations Conversation[]

  @@map("family")
  @@schema("chat")
}

model Contact {
  /// PRD 2.3 -- organization_id on every root entity. SQL owns the DDL.
  organizationId    String   @default(dbgenerated("chat.default_organization_id()")) @map("organization_id") @db.Uuid
  id                String   @id @default(uuid()) @db.Uuid
  familyId          String   @map("family_id") @db.Uuid
  family            Family   @relation(fields: [familyId], references: [id])
  name              String
  relationship      String?
  rolePreset        String   @map("role_preset")
  canMessage        Boolean  @default(false) @map("can_message")
  canViewProgress   Boolean  @map("can_view_progress")
  canManageSchedule Boolean  @map("can_manage_schedule")
  canManageBilling  Boolean  @map("can_manage_billing")
  canManageContacts Boolean  @map("can_manage_contacts")
  canCancel         Boolean  @map("can_cancel")
  accountId         String?  @map("account_id") @db.Uuid
  account           Account? @relation(fields: [accountId], references: [id])
  /// A profile photo: `avatars/<kind>/<this id>/<uuid>` (CHECK in 20261014130000). Never sent to a client; served as a signed /media/avatars URL.
  avatarObjectKey   String?  @map("avatar_object_key")
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  /// The Chat-owned About. A SIBLING, never a column on this row -- see
  /// `20261021010000_chat_parent_profile.sql` for why ownership is kept separate.
  profile ContactProfile?

  @@map("contact")
  @@schema("chat")
}

model Learner {
  /// PRD 2.3 -- organization_id on every root entity. SQL owns the DDL.
  organizationId  String    @default(dbgenerated("chat.default_organization_id()")) @map("organization_id") @db.Uuid
  id              String    @id @default(uuid()) @db.Uuid
  familyId        String    @map("family_id") @db.Uuid
  family          Family    @relation(fields: [familyId], references: [id])
  name            String
  level           String?
  /// Now a real relationship: chat.teacher landed in the PR-A identity
  /// foundation and learner.teacher_id is a foreign key to it.
  teacherId       String?   @map("teacher_id") @db.Uuid
  teacher         Teacher?  @relation(fields: [teacherId], references: [id])
  /// A profile photo: `avatars/<kind>/<this id>/<uuid>` (CHECK in 20261014130000). Never sent to a client; served as a signed /media/avatars URL.
  avatarObjectKey String?   @map("avatar_object_key")
  nextClassAt     DateTime? @map("next_class_at") @db.Timestamptz
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  conversations Conversation[]
  lessons       Lesson[]

  /// Chat-owned About, deliberately NOT a column on this row: a learner is an
  /// academy entity and a future Core projection must not be able to overwrite it.
  profile LearnerProfile?

  @@map("learner")
  @@schema("chat")
}

model Config {
  key       String   @id
  value     Json
  scope     String   @default("global")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("config")
  @@schema("chat")
}

model EventLog {
  /// bigint identity, generated by the database (AI #1's definition).
  id        BigInt   @id @default(autoincrement())
  familyId  String?  @map("family_id") @db.Uuid
  actorKind String   @map("actor_type")
  actorId   String?  @map("actor_id") @db.Uuid
  type      String
  payload   Json     @default("{}")
  at        DateTime @default(now()) @db.Timestamptz

  @@map("event_log")
  @@schema("chat")
}

model AuditLog {
  /// bigint identity, generated by the database (AI #1's definition).
  id              BigInt   @id @default(autoincrement())
  actorId         String?  @map("actor_id") @db.Uuid
  action          String
  entity          String
  entityId        String   @map("entity_id") @db.Uuid
  before          Json?
  after           Json?
  reason          String
  at              DateTime @default(now()) @db.Timestamptz
  /// PD-21: set when written during a support session (an administrator acting as someone).
  impersonationId String?  @map("impersonation_id") @db.Uuid

  @@map("audit_log")
  @@schema("chat")
}

// =====================================================================
// AI #2 -- communication domain
// =====================================================================

model Conversation {
  /// PRD 2.3 -- organization_id on every root entity. SQL owns the DDL.
  organizationId String   @default(dbgenerated("chat.default_organization_id()")) @map("organization_id") @db.Uuid
  id             String   @id @default(uuid()) @db.Uuid
  type           String
  familyId       String?  @map("family_id") @db.Uuid
  family         Family?  @relation(fields: [familyId], references: [id])
  learnerId      String?  @map("learner_id") @db.Uuid
  learner        Learner? @relation(fields: [learnerId], references: [id])
  title          String?

  /// Canonical id of a 1:1 channel; makes a duplicate direct conversation impossible.
  directKey String? @unique @map("direct_key")

  /// PD-11/PD-12: the teacher a teacher_supervision conversation is about (that type only).
  supervisedTeacherId String? @map("supervised_teacher_id") @db.Uuid

  /// PD-11 T4: the teacher a trial_group conversation belongs to (that type only).
  trialTeacherId String? @map("trial_teacher_id") @db.Uuid
  /// PD-35 B6: the department a department_room belongs to (20261027100000 owns the DDL).
  departmentId   String? @map("department_id") @db.Uuid

  state String @default("open")

  teacherRequiresApproval Boolean @default(false) @map("teacher_requires_approval") // PD-14: retired, always false
  parentRequiresApproval  Boolean @default(false) @map("parent_requires_approval") // PD-14: retired, always false

  stickyHandlerId String?   @map("sticky_handler_id") @db.Uuid
  stickyHandler   Staff?    @relation("ConversationStickyHandler", fields: [stickyHandlerId], references: [id])
  stickyUntil     DateTime? @map("sticky_until") @db.Timestamptz

  /// Server-assigned monotonic message counter.
  lastSeq BigInt @default(0) @map("last_seq")

  lastCustomerMessageAt DateTime? @map("last_customer_message_at") @db.Timestamptz
  lastStaffMessageAt    DateTime? @map("last_staff_message_at") @db.Timestamptz
  lastActivityAt        DateTime  @default(now()) @map("last_activity_at") @db.Timestamptz
  resolvedAt            DateTime? @map("resolved_at") @db.Timestamptz
  archivedAt            DateTime? @map("archived_at") @db.Timestamptz
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  members       ConversationMember[]
  messages      Message[]
  approvals     MessageApproval[]
  participants  ConversationParticipantState[]
  calls         Call[]
  notifications Notification[]

  @@map("conversation")
  @@schema("chat")
}

/// The explicit participant set BR-1 is enforced against.
model ConversationMember {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @map("conversation_id") @db.Uuid
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  actorKind      String       @map("actor_kind")
  actorId        String       @map("actor_id") @db.Uuid
  memberRole     String       @map("member_role")
  isSilent       Boolean      @default(false) @map("is_silent")
  addedBy        String?      @map("added_by") @db.Uuid
  joinedAt       DateTime     @default(now()) @map("joined_at") @db.Timestamptz
  leftAt         DateTime?    @map("left_at") @db.Timestamptz

  @@map("conversation_member")
  @@schema("chat")
}

model Message {
  /// PRD 2.3 -- organization_id on every root entity. SQL owns the DDL.
  organizationId String        @default(dbgenerated("chat.default_organization_id()")) @map("organization_id") @db.Uuid
  id             String        @id @default(uuid()) @db.Uuid
  conversationId String?       @map("conversation_id") @db.Uuid
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  authorType   String  @map("author_type")
  authorId     String? @map("author_id") @db.Uuid
  onBehalfMode String? @map("on_behalf_mode")

  type       String  @default("text")
  body       String?
  visibility String
  moderation String  @default("published")
  origin     String  @default("user")

  seq BigInt?

  replyToMessageId       String?   @map("reply_to_message_id") @db.Uuid
  /// A forward (20261020100000); `forwardedFromMessageId` is audit-only provenance, never sent to a client.
  forwarded              Boolean   @default(false)
  forwardedFromMessageId String?   @map("forwarded_from_message_id") @db.Uuid
  /// PD-21: sent by an administrator in a support session, as this author. Clients label it.
  impersonationId        String?   @map("impersonation_id") @db.Uuid
  replyTo                Message?  @relation("MessageReply", fields: [replyToMessageId], references: [id])
  replies                Message[] @relation("MessageReply")

  clientMessageId String? @map("client_message_id")

  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz
  deletedBy      String?   @map("deleted_by") @db.Uuid
  deletedForAll  Boolean   @default(false) @map("deleted_for_all")
  redactedReason String?   @map("redacted_reason")

  /// Superseded by MessageAttachment; kept because AI #1 defined it NOT NULL.
  attachmentsJson Json @default("[]") @map("attachments")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  /// Set by a recorded edit (MessageService.edit); the prior wording is in MessageRevision.
  editedAt  DateTime? @map("edited_at") @db.Timestamptz

  attachments MessageAttachment[]
  /// PD-11: the structured half of a message of type `card`.
  card        MessageCard?
  reactions   MessageReaction[]
  receipts    MessageReceipt[]
  hiddenFor   MessageHiddenFor[]
  approval    MessageApproval?
  /// PD-36: the @mentions in this message (chips, notifications, summonses).
  mentions    MessageMention[]

  @@map("message")
  @@schema("chat")
}

/// PD-36: one @mention of one person in one message. SQL owns the DDL and the
/// floor (chat.guard_message_mention): a summons names only staff with a PD-8
/// basis on the conversation, and a role mention never names the super admin.
model MessageMention {
  id              String    @id @default(uuid()) @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  conversationId  String    @map("conversation_id") @db.Uuid
  messageId       String    @map("message_id") @db.Uuid
  message         Message   @relation(fields: [messageId], references: [id], onDelete: Cascade)
  mentionedBy     String    @map("mentioned_by") @db.Uuid
  mentionedByKind String    @map("mentioned_by_kind")
  targetActorId   String    @map("target_actor_id") @db.Uuid
  targetKind      String    @map("target_kind")
  /// A parent's role mention ('supervisor' | 'admin'), expanded per person; null for a named person.
  viaRole         String?   @map("via_role")
  /// The target was not a live member when mentioned.
  isSummons       Boolean   @map("is_summons")
  /// UTF-16 offsets of the "@..." in message.body.
  spanStart       Int       @map("span_start")
  spanLength      Int       @map("span_length")
  state           String
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  expiresAt       DateTime? @map("expires_at") @db.Timestamptz
  seenAt          DateTime? @map("seen_at") @db.Timestamptz
  resolvedAt      DateTime? @map("resolved_at") @db.Timestamptz
  resolvedBy      String?   @map("resolved_by") @db.Uuid

  @@unique([messageId, targetActorId, spanStart])
  @@map("message_mention")
  @@schema("chat")
}

model MessageAttachment {
  id                 String   @id @default(uuid()) @db.Uuid
  messageId          String   @map("message_id") @db.Uuid
  message            Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  kind               String
  objectKey          String   @unique @map("object_key")
  mimeType           String   @map("mime_type")
  byteSize           Int      @map("byte_size")
  checksumSha256     String?  @map("checksum_sha256")
  originalName       String?  @map("original_name")
  durationMs         Int?     @map("duration_ms")
  width              Int?
  height             Int?
  thumbnailObjectKey String?  @map("thumbnail_object_key")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("message_attachment")
  @@schema("chat")
}

model MessageReaction {
  id        String   @id @default(uuid()) @db.Uuid
  messageId String   @map("message_id") @db.Uuid
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  actorId   String   @map("actor_id") @db.Uuid
  emoji     String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@unique([messageId, actorId])
  @@map("message_reaction")
  @@schema("chat")
}

/// A private bookmark (20261020091000). SQL owns the DDL; no relation fields so
/// the Message model stays untouched -- rows cascade with their message.
model MessageStar {
  messageId String   @map("message_id") @db.Uuid
  actorId   String   @map("actor_id") @db.Uuid
  starredAt DateTime @default(now()) @map("starred_at") @db.Timestamptz

  @@id([messageId, actorId])
  @@map("message_star")
  @@schema("chat")
}

/// A message pinned for everyone in its conversation; at most three (trigger
/// chat.enforce_message_pin, 20261020091000).
model MessagePin {
  conversationId String   @map("conversation_id") @db.Uuid
  messageId      String   @map("message_id") @db.Uuid
  pinnedBy       String   @map("pinned_by") @db.Uuid
  pinnedByKind   String   @map("pinned_by_kind")
  pinnedAt       DateTime @default(now()) @map("pinned_at") @db.Timestamptz

  @@id([conversationId, messageId])
  @@map("message_pin")
  @@schema("chat")
}

model MessageReceipt {
  id          String    @id @default(uuid()) @db.Uuid
  messageId   String    @map("message_id") @db.Uuid
  message     Message   @relation(fields: [messageId], references: [id], onDelete: Cascade)
  actorId     String    @map("actor_id") @db.Uuid
  state       String    @default("sent")
  sentAt      DateTime  @default(now()) @map("sent_at") @db.Timestamptz
  deliveredAt DateTime? @map("delivered_at") @db.Timestamptz
  readAt      DateTime? @map("read_at") @db.Timestamptz

  @@unique([messageId, actorId])
  @@map("message_receipt")
  @@schema("chat")
}

model MessageHiddenFor {
  messageId String   @map("message_id") @db.Uuid
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  actorId   String   @map("actor_id") @db.Uuid
  hiddenAt  DateTime @default(now()) @map("hidden_at") @db.Timestamptz

  @@id([messageId, actorId])
  @@map("message_hidden_for")
  @@schema("chat")
}

model ConversationParticipantState {
  id                  String       @id @default(uuid()) @db.Uuid
  conversationId      String       @map("conversation_id") @db.Uuid
  conversation        Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  actorId             String       @map("actor_id") @db.Uuid
  lastReadSeq         BigInt       @default(0) @map("last_read_seq")
  /// PD-37: how far this person's devices have the conversation; forward-only, >= lastReadSeq (20261026180000).
  lastDeliveredSeq    BigInt       @default(0) @map("last_delivered_seq")
  /// PD-37: when lastReadSeq last moved forward.
  lastReadAt          DateTime?    @map("last_read_at") @db.Timestamptz
  archivedAt          DateTime?    @map("archived_at") @db.Timestamptz
  mutedUntil          DateTime?    @map("muted_until") @db.Timestamptz
  pinnedAt            DateTime?    @map("pinned_at") @db.Timestamptz
  /// The viewer's own Favorites list.
  favoritedAt         DateTime?    @map("favorited_at") @db.Timestamptz
  /// The viewer's own background preset for this chat (20261020150000); null = default.
  theme               String?
  /// The viewer's own wallpaper photo: wallpapers/<actor_id>/<conversation_id>/<uuid>.
  wallpaperObjectKey  String?      @map("wallpaper_object_key")
  /// One authorized-but-uncommitted wallpaper upload (20261020160000).
  wallpaperPendingKey String?      @map("wallpaper_pending_key")
  updatedAt           DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([conversationId, actorId])
  @@map("conversation_participant_state")
  @@schema("chat")
}

model MessageApproval {
  /// PRD 2.3 -- organization_id on every root entity. SQL owns the DDL.
  organizationId  String       @default(dbgenerated("chat.default_organization_id()")) @map("organization_id") @db.Uuid
  id              String       @id @default(uuid()) @db.Uuid
  messageId       String       @unique @map("message_id") @db.Uuid
  message         Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  conversationId  String       @map("conversation_id") @db.Uuid
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  requestedBy     String       @map("requested_by") @db.Uuid
  approverId      String?      @map("approver_id") @db.Uuid
  decision        String       @default("pending")
  rejectionReason String?      @map("rejection_reason")
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz
  decidedAt       DateTime?    @map("decided_at") @db.Timestamptz

  @@map("message_approval")
  @@schema("chat")
}

model OutboxEvent {
  id          String    @id @default(uuid()) @db.Uuid
  type        String
  payload     Json
  status      String    @default("pending")
  attempts    Int       @default(0)
  lastError   String?   @map("last_error")
  availableAt DateTime  @default(now()) @map("available_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  publishedAt DateTime? @map("published_at") @db.Timestamptz

  @@map("outbox_event")
  @@schema("chat")
}

model DeviceToken {
  /// PRD 2.3 -- organization_id on every root entity. SQL owns the DDL.
  organizationId String   @default(dbgenerated("chat.default_organization_id()")) @map("organization_id") @db.Uuid
  id             String   @id @default(uuid()) @db.Uuid
  actorId        String   @map("actor_id") @db.Uuid
  token          String   @unique
  platform       String
  isVoip         Boolean  @default(false) @map("is_voip")
  locale         String   @default("ar")
  isActive       Boolean  @default(true) @map("is_active")
  lastSeenAt     DateTime @default(now()) @map("last_seen_at") @db.Timestamptz
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("device_token")
  @@schema("chat")
}

model NotificationTemplate {
  /// PRD 2.3 -- organization_id on every root entity. SQL owns the DDL.
  organizationId String   @default(dbgenerated("chat.default_organization_id()")) @map("organization_id") @db.Uuid
  id             String   @id @default(uuid()) @db.Uuid
  key            String
  locale         String
  version        Int      @default(1)
  title          String
  body           String
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@unique([key, locale, version])
  @@map("notification_template")
  @@schema("chat")
}

model NotificationRule {
  /// PRD 2.3 -- organization_id on every root entity. SQL owns the DDL.
  organizationId    String   @default(dbgenerated("chat.default_organization_id()")) @map("organization_id") @db.Uuid
  key               String   @id
  eventType         String   @map("event_type")
  offsetSeconds     Int      @default(0) @map("offset_seconds")
  templateKey       String   @map("template_key")
  recipientRole     String   @map("recipient_role")
  channel           String   @default("push")
  priority          String   @default("normal")
  respectQuietHours Boolean  @default(true) @map("respect_quiet_hours")
  enabled           Boolean  @default(true)
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  notifications Notification[]

  @@map("notification_rule")
  @@schema("chat")
}

model Notification {
  /// PRD 2.3 -- organization_id on every root entity. SQL owns the DDL.
  organizationId String            @default(dbgenerated("chat.default_organization_id()")) @map("organization_id") @db.Uuid
