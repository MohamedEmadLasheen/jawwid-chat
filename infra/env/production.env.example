# Jawwid Chat — production environment template.
#
# GENERATED FILE. Do not edit by hand.
#   scripts/infra/render-env-template.sh production > infra/env/production.env.example
#
# Every variable marked SECRET is supplied at deploy time from the secret store
# (docs/infrastructure/secrets.md). It is never written here, never committed,
# and never printed by a build log.
#
# Validate a real environment before deploying:
#   scripts/infra/check-env.sh production

# --- application ---
NODE_ENV=
APP_ENV=
TRUSTED_PROXY_HOPS=
PORT=
LOG_LEVEL=
CORS_ALLOWED_ORIGINS=
REQUEST_TIMEOUT_MS=
SHUTDOWN_GRACE_MS=

# --- database ---
DATABASE_URL=   # SECRET — inject from the secret store
DATABASE_STATEMENT_TIMEOUT_MS=
DATABASE_POOL_MAX=

# --- redis ---
REDIS_URL=   # SECRET — inject from the secret store
QUEUE_PREFIX=
WORKER_CONCURRENCY=

# --- auth ---
JWT_ACCESS_SECRET=   # SECRET — inject from the secret store
JWT_REFRESH_SECRET=   # SECRET — inject from the secret store
JWT_ACCESS_TTL=
JWT_REFRESH_TTL=

# --- storage ---
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=   # SECRET — inject from the secret store
STORAGE_SECRET_KEY=   # SECRET — inject from the secret store
STORAGE_SIGNED_URL_TTL_SECONDS=
STORAGE_SIGNING_SECRET=   # SECRET — inject from the secret store
MEDIA_PUBLIC_BASE_URL= optional
STORAGE_LOCAL_ROOT= optional
STORAGE_PUBLIC_BASE_URL= optional

# --- worker ---
OUTBOX_POLL_MS= optional
OUTBOX_BATCH_SIZE= optional
OUTBOX_IDLE_BACKOFF_MS= optional

# --- storage ---
ATTACHMENT_MAX_BYTES_IMAGE= optional
ATTACHMENT_MAX_BYTES_VIDEO= optional
ATTACHMENT_MAX_BYTES_VOICE= optional
ATTACHMENT_MAX_BYTES_FILE= optional
ATTACHMENT_MAX_VOICE_DURATION_MS= optional

# --- materials ---
MATERIALS_SITE_BASE_URL= optional
MATERIALS_FRAME_ORIGINS= optional

# --- push ---
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=   # SECRET — inject from the secret store
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=
APNS_PRIVATE_KEY=   # SECRET — inject from the secret store
APNS_PRODUCTION=

# --- calling ---
LIVEKIT_URL=
LIVEKIT_API_KEY=   # SECRET — inject from the secret store
LIVEKIT_API_SECRET=   # SECRET — inject from the secret store

# --- core ---
CORE_BASE_URL=
CORE_API_KEY=   # SECRET — inject from the secret store
CORE_WEBHOOK_SECRET=   # SECRET — inject from the secret store
CORE_TIMEOUT_MS=
CORE_RETRY_MAX=

# --- backup ---
BACKUP_ENCRYPTION_KEY_FILE= optional
BACKUP_ENCRYPTION_PASSPHRASE=   # SECRET — inject from the secret store; optional

# --- payroll ---
TEACHER_PAYOUT_KEYS=   # SECRET — inject from the secret store; optional

# --- payments ---
STRIPE_SECRET_KEY=   # SECRET — inject from the secret store; optional
STRIPE_WEBHOOK_SECRET=   # SECRET — inject from the secret store; optional
PAYMENT_LINK_BASE_URL= optional
SUBSCRIPTION_LOCK_ENFORCED= optional

# --- application ---
TEACHER_SUPERVISOR_STRICT_SCOPE= optional

# --- observability ---
SENTRY_DSN=   # SECRET — inject from the secret store
OTEL_SERVICE_NAME= optional
OTEL_EXPORTER_OTLP_ENDPOINT= optional
OTEL_TRACES_SAMPLER_ARG= optional
HEALTH_PROBE_TIMEOUT_MS= optional

# --- release ---
GIT_COMMIT=
BUILD_VERSION=
BUILD_TIME=

# --- recovery ---
SMTP_URL=   # SECRET — inject from the secret store
RECOVERY_MAIL_FROM=
WHATSAPP_PHONE_NUMBER_ID= optional
WHATSAPP_ACCESS_TOKEN=   # SECRET — inject from the secret store; optional
WHATSAPP_RECOVERY_TEMPLATE= optional
WHATSAPP_TEMPLATE_LANGUAGE= optional
WHATSAPP_API_VERSION= optional

# --- guardrail ---
PRISMA_MIGRATE_SKIP_GENERATE= optional
