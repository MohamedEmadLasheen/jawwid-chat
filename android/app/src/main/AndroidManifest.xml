<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Every API call, realtime socket and call. Flutter's template declares INTERNET only
         in the debug/profile manifests, and no plugin here declares it, so without this a
         RELEASE build cannot reach the network at all (found building the first Android
         release APK, 2026-10-27). -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Voice notes. Requested at the moment the user first presses record, never
         at launch: a permission prompt with no visible cause is the one users deny. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <!-- W8-W1. Android 13+ requires this before a notification can be shown.
         Requested at the point a notification first matters, never at launch.
         The token itself needs no permission; this is about DISPLAY. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- PD-23 app lock (Face / fingerprint via BiometricPrompt, device credential as the
         fallback). The local_auth plugin declares it too; stated here so the app's own
         manifest says what it asks for. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC"/>
    <!-- Store blocker S-05: an incoming call rings over the lock screen while the app is
         closed. Google Play grants this only to calling and alarm apps (Android 14+ checks
         it at runtime: JawwidPush.mayUseFullScreenIntent) and the Play Console needs the
         "full-screen intent" declaration for a calling app; without it the ring is a
         heads-up notification, still with Answer and Decline. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT"/>
    <!-- Store blocker S-06: an ongoing call keeps its microphone when the app goes to the
         background (CallForegroundService, type microphone only). LR-14: Android reserves
         the phone-call service type for calls run through a Telecom ConnectionService,
         which this app does not have, so it is not declared and neither is its permission. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE"/>
    <!-- enableOnBackInvokedCallback: predictive back (Android 14+). The system back
         gesture previews the screen underneath before it commits; Flutter drives it
         through the PredictiveBackPageTransitionsBuilder in lib/design/theme.dart.
         allowBackup="false": no Android cloud backup or device transfer. The session
         tokens are bound to this device's keystore, so a restored copy could not be
         decrypted, and the app's preferences are not worth copying off the phone.
         dataExtractionRules (LR-46 P3-13): on Android 12+ device-to-device transfer
         ignores allowBackup, so res/xml/data_extraction_rules.xml excludes every domain
         from both cloud backup and device transfer. On API 26-30 (minSdk 26)
         allowBackup="false" alone already stops both, so no fullBackupContent is needed. -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:label="@string/app_name"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:enableOnBackInvokedCallback="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Store blocker S-05: FCM data messages while the app is closed (JawwidPush). -->
        <service
            android:name=".JawwidMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT"/>
            </intent-filter>
        </service>
        <!-- S-06: an ongoing call survives backgrounding. -->
        <service
            android:name=".CallForegroundService"
            android:exported="false"
            android:foregroundServiceType="microphone"/>
        <!-- "Decline" on the incoming-call notification, "Hang up" on the ongoing one. -->
        <receiver
            android:name=".CallActionReceiver"
            android:exported="false"/>
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="jawwid_messages"/>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
