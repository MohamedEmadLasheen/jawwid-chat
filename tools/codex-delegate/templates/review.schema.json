{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Codex review report",
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "findings", "coverage_notes"],
  "properties": {
    "verdict": {
      "type": "string",
      "enum": ["merge", "fix_first", "unable_to_review"],
      "description": "unable_to_review if the diff or sources could not be read."
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "file", "line", "title", "explanation", "scenario"],
        "properties": {
          "severity": { "type": "string", "enum": ["P1", "P2", "P3"] },
          "file": { "type": "string" },
          "line": { "type": "integer" },
          "title": { "type": "string" },
          "explanation": { "type": "string" },
          "scenario": { "type": "string", "description": "Concrete inputs or sequence that reproduces it." }
        }
      }
    },
    "coverage_notes": {
      "type": "string",
      "description": "What was and was not inspected, so the lead can judge blind spots."
    }
  }
}
