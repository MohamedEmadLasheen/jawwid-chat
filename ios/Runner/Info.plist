<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>ar</string>
	</array>
	<key>CFBundleDisplayName</key>
	<string>Jawwid Chat</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>jawwid_chat</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- PD-56: only the system's standard encryption (HTTPS/TLS, WebRTC's
	     DTLS-SRTP), which is exempt; App Store Connect then asks no export
	     compliance question per build. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- W8-W1. `voip` lets a PushKit push wake the app so an incoming call can
	     be reported; `remote-notification` does the same for a data push.
	     Receiving a VoIP push obliges an immediate CallKit report, which is
	     W8-W3's -- until it exists the SERVER does not deliver one
	     (APNS_VOIP_ENABLED defaults to false). -->
	<key>UIBackgroundModes</key>
	<array>
		<string>voip</string>
		<string>remote-notification</string>
		<!-- PD-56: a voice call keeps its audio when the screen locks or the
		     person switches app. -->
		<string>audio</string>
	</array>
	<!-- Required before the system will even present the camera. Without it iOS
	     terminates the app on capture rather than refusing it, so this is not a
	     nicety: attaching a photo from the camera is unreachable without it. -->
	<key>NSCameraUsageDescription</key>
	<string>Jawwid uses the camera to take a photo or record a video to send in a conversation.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Jawwid lets you choose a photo or a video to send in a conversation, or a photo to use as a profile photo.</string>
	<!-- PD-39: a board exported as a picture goes to the share sheet, whose "Save Image"
	     adds it to Photos. Without this key iOS terminates the app at that tap. -->
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Jawwid saves a board you export as a picture to your photo library.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Jawwid uses the microphone to record voice messages and the sound of videos you record, and to make voice calls.</string>
	<!-- PD-23 app lock. Without it iOS refuses Face ID outright (and a passcode-only
	     fallback is all that remains). The app never sees biometric data: the system
	     answers yes or no. -->
	<key>NSFaceIDUsageDescription</key>
	<string>Jawwid uses Face ID to unlock the app, if you turn on app lock.</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<!-- LR-39: the iPhone app is portrait only. Its layouts were never checked in
	     landscape, and the target is iPhone only (TARGETED_DEVICE_FAMILY = 1). -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
