# Jawwid Chat — local development environment. Owner: AI #7 (infrastructure).
#
#   cp .env.example .env      # .env is gitignored; never commit it
#
# PLACEHOLDERS ONLY. Every value below is either a local-only credential or an
# obvious dummy. A real staging or production secret must never appear in this
# file, in any file tracked by git, or in any document.
#
# The authoritative, annotated inventory of every variable — including which are
# secret and which are required per environment — is
# docs/infrastructure/environment.md.

# ----------------------------------------------------------------- application
NODE_ENV=development
# APP_ENV is the deployment identity and is ALWAYS explicit. NODE_ENV only says
# "optimised build or not"; it cannot distinguish staging from production, and
# code that guesses the environment guesses wrong on the day it matters.
APP_ENV=local
PORT=3000
LOG_LEVEL=debug

# Exact origins allowed to call the API with credentials. Comma-separated.
# Never `*` — see docs/infrastructure/architecture.md "CORS".
CORS_ALLOWED_ORIGINS=http://localhost:5174

# ----------------------------------------------------------- local stack ports
# Match the containers the team already runs. Override to run two checkouts
# side by side: POSTGRES_PORT=15433 REDIS_PORT=16380 docker compose up -d
POSTGRES_PORT=5433
POSTGRES_DB=jawwid_chat
POSTGRES_PASSWORD=postgres
REDIS_PORT=6380
STORAGE_PORT=9000
STORAGE_CONSOLE_PORT=9001

# ------------------------------------------------------------------- database
# TWO ROLES, one per process kind (docs/security/RLS-STRATEGY.md 3):
#
#   DATABASE_URL          the API request path. Should point at `chat_app`,
#                         which is NOBYPASSRLS, so every request runs inside
#                         the actor context PrismaService.withActor() sets and
#                         a service-layer scope bug is caught by the database.
#                         /health/ready reports `rlsEnforced`, which is false
#                         while this still connects as an owner or superuser.
#   DATABASE_SERVICE_URL  the worker, migrations and Core ingestion. Points at
#                         `chat_service`, which bypasses RLS because it acts
#                         for the system rather than for a user. The API
#                         process must NOT have this in its environment.
#
# The two roles are created NOLOGIN by migration 20260907100300; deployment
# grants LOGIN and a password from the secret store, so no migration ever
# contains a credential.
DATABASE_URL=postgresql://jawwid:jawwid@localhost:5433/jawwid_chat?schema=public
DATABASE_SERVICE_URL=postgresql://jawwid:jawwid@localhost:5433/jawwid_chat?schema=public
# Bounded so one slow query cannot hold a connection forever.
DATABASE_STATEMENT_TIMEOUT_MS=15000
DATABASE_POOL_MAX=10

# ---------------------------------------------------------------------- redis
REDIS_URL=redis://localhost:6380
# Namespaces BullMQ keys so a shared Redis cannot collide across environments.
QUEUE_PREFIX=jawwid-chat-local
WORKER_CONCURRENCY=5

# ----------------------------------------------------------- object storage
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=auto
STORAGE_BUCKET=jawwid-chat-attachments
STORAGE_ACCESS_KEY=jawwid-dev
STORAGE_SECRET_KEY=jawwid-dev-secret
STORAGE_SIGNED_URL_TTL_SECONDS=300
# Signs attachment URLs. The API REFUSES TO START if this is missing or shorter
# than 32 characters -- without it, signed attachment URLs are forgeable.
STORAGE_SIGNING_SECRET=local-development-attachment-signing-secret-0123456789

# Outbox worker (node dist/worker.js). Poll interval while there is work, batch
# size, and the slower interval used when the outbox is empty.
OUTBOX_POLL_MS=1000
OUTBOX_BATCH_SIZE=100
OUTBOX_IDLE_BACKOFF_MS=5000
ATTACHMENT_MAX_BYTES_IMAGE=10485760
ATTACHMENT_MAX_BYTES_VIDEO=104857600
ATTACHMENT_MAX_BYTES_VOICE=16777216
ATTACHMENT_MAX_BYTES_FILE=26214400

# ----------------------------------------------------------------------- auth
# The process REFUSES TO START without these: both must be set, at least 32
# characters, and DIFFERENT from each other. There is deliberately no
# development fallback -- a default that works locally is a default that ships
# (apps/api/src/platform/auth/startup.ts).
#
# Distinct keys matter: the access key signs tokens, the refresh key hashes the
# refresh tokens and one-time tokens at rest, so compromising one does not let
# an attacker forge the other. Local values are throwaway strings.
JWT_ACCESS_SECRET=local-development-access-secret-not-a-real-key
JWT_REFRESH_SECRET=local-development-refresh-secret-not-a-real-key
# Optional overrides; the defaults live in chat.config (auth.*) so session
# policy is an operations change rather than a deploy.
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ------------------------------------------------------------ push (AI #2/#3)
# Empty locally: the push provider is stubbed in development. See
# docs/infrastructure/handoff-ai2.md.
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.jawwid.chat
APNS_PRIVATE_KEY=
APNS_PRODUCTION=false

# ------------------------------------------------------------ calling (LiveKit)
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret-local-only
LIVEKIT_TOKEN_TTL_SECONDS=300

# ------------------------------------------------------------- Jawwid Core
CORE_BASE_URL=http://localhost:54321
CORE_API_KEY=
CORE_WEBHOOK_SECRET=
CORE_TIMEOUT_MS=5000
CORE_RETRY_MAX=3

# ------------------------------------------------------------- observability
SENTRY_DSN=
OTEL_SERVICE_NAME=jawwid-chat-api
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_TRACES_SAMPLER_ARG=1.0
HEALTH_PROBE_TIMEOUT_MS=2000

# ----------------------------------------------------------------- lifecycle
# How long to finish in-flight work after SIGTERM before forcing exit.
SHUTDOWN_GRACE_MS=15000
REQUEST_TIMEOUT_MS=30000

# ------------------------------------------------------- build identity (CI)
# Injected by the pipeline. Left `unknown` locally, which is correct: a laptop
# build is not a release.
GIT_COMMIT=
BUILD_VERSION=
BUILD_TIME=
